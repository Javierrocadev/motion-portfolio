---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Motion Portfolio">
  <main class="container">
    <h1>Motion Portfolio</h1>
    <p>Proyecto base listo con Astro y CSS.</p>
  </main>
</BaseLayout>

<style>
  .container {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  p {
    color: var(--muted);
  }
</style>

