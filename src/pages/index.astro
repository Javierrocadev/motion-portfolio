---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSplitLayout from '../layouts/HeroSplitLayout.astro';
import HeroLeftMedia from '../components/hero/HeroLeftMedia.astro';
import HeroProjectStage from '../components/hero/HeroProjectStage.astro';
import { HERO_DEFAULT_PORTRAIT, PROJECTS } from '../data/projects';

const activeProject = PROJECTS[0];
---

<BaseLayout
  title="Motion Portfolio"
  description="Portfolio interactivo con layout dividido 40/60"
>
  <main>
    <HeroSplitLayout activeProjectId={activeProject.id}>
      <HeroLeftMedia slot="left" media={HERO_DEFAULT_PORTRAIT} />
      <HeroProjectStage slot="right" projects={PROJECTS} />
    </HeroSplitLayout>
  </main>
</BaseLayout>
