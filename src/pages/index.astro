---
import PortfolioShell from '../layouts/PortfolioShell.astro';
import HomeScreen from '../components/screens/HomeScreen.astro';
import { getProjects } from '../data/projects';

const projects = await getProjects('es');
---

<PortfolioShell locale="es" route="home" activeProjectId={projects[0]?.id}>
  <HomeScreen locale="es" projects={projects} />
</PortfolioShell>
