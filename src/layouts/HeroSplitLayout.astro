---
interface Props {
  activeProjectId?: string;
  ariaLabel?: string;
}

const {
  activeProjectId = '',
  ariaLabel = 'Presentación principal y proyecto destacado',
} = Astro.props;
---

<section
  class="hero-split"
  data-hero-root
  data-active-project={activeProjectId}
  aria-label={ariaLabel}
>
  <div class="hero-split__left" data-hero-region="left">
    <slot name="left" />
  </div>

  <div class="hero-split__right" data-hero-region="right">
    <slot name="nav" />
    <div id="page-screen" class="hero-split__screen" data-page-screen>
      <slot name="right" />
    </div>
  </div>
</section>

<script>
  import { initHeroBridge } from '../scripts/heroBridge';

  initHeroBridge('[data-hero-root]');
</script>

<style>
  .hero-split {
    --hero-scroll-progress: 0;
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 600px;
    display: grid;
    grid-template-columns: var(--hero-left-width, 40%) minmax(0, 1fr);
    background-color: var(--bg);
    overflow: hidden;
  }

  .hero-split__left {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    view-transition-name: split-left;
  }

  .hero-split__right {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    border-inline-start: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-split__screen {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    view-transition-name: page-screen;
  }

  @media (max-width: 900px) {
    .hero-split {
      height: auto;
      min-height: 100dvh;
      grid-template-columns: 1fr;
      grid-template-rows: 46dvh minmax(54dvh, auto);
    }

    .hero-split__right {
      border-inline-start: 0;
      border-block-start: 1px solid var(--line);
    }
  }
</style>
