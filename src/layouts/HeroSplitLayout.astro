---
interface Props {
  activeProjectId?: string;
}

const { activeProjectId = '' } = Astro.props;
---

<section
  class="hero-split"
  data-hero-root
  data-active-project={activeProjectId}
  aria-label="Presentación principal y proyecto destacado"
>
  <div class="hero-split__left" data-hero-region="left">
    <slot name="left" />
  </div>

  <div class="hero-split__right" data-hero-region="right">
    <slot name="right" />
  </div>
</section>

<script>
  import { initHeroBridge } from '../scripts/heroBridge';

  initHeroBridge('[data-hero-root]');
</script>

<style>
  .hero-split {
    --hero-scroll-progress: 0;
    position: relative;
    width: 100%;
    height: 100dvh;
    min-height: 600px;
    display: grid;
    grid-template-columns: var(--hero-left-width, 40%) minmax(0, 1fr);
    background-color: var(--bg);
    overflow: hidden;
  }

  .hero-split__left {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    border-right: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-split__right {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .hero-split {
      height: auto;
      min-height: 100dvh;
      grid-template-columns: 1fr;
      grid-template-rows: 46dvh minmax(54dvh, auto);
    }

    .hero-split__left {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
