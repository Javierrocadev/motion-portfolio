---
import BaseLayout from './BaseLayout.astro';
import HeroSplitLayout from './HeroSplitLayout.astro';
import HeroLeftMedia from '../components/hero/HeroLeftMedia.astro';
import SiteNav from '../components/nav/SiteNav.astro';
import { type Locale, type RouteKey } from '../i18n/routes';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
  route: RouteKey;
  activeProjectId?: string;
}

const { locale, route, activeProjectId } = Astro.props;
const t = getTranslations(locale);
const meta = t.meta[route];

const leftBrand = {
  alt: t.layout.portraitAlt,
  caption: t.layout.portraitCaption,
};

const leftPortrait =
  route === 'about'
    ? {
        src: '/images/perfil-bg.webp',
        alt: t.about.portraitAlt,
        toggleAria: t.about.portraitToggleAria,
      }
    : undefined;
---

<BaseLayout
  lang={locale}
  route={route}
  title={meta.title}
  description={meta.description}
  preloadImage={leftPortrait?.src}
>
  <main>
    <HeroSplitLayout
      activeProjectId={activeProjectId}
      ariaLabel={t.layout.heroAriaLabel}
    >
      <HeroLeftMedia
        slot="left"
        locale={locale}
        media={leftBrand}
        portrait={leftPortrait}
        ariaLabel={leftPortrait ? t.about.portraitAlt : t.layout.leftMediaAriaLabel}
        detailsLabels={t.projectDetails}
      />
      <SiteNav slot="nav" locale={locale} currentRoute={route} />
      <div slot="right" style="display: contents">
        <slot />
      </div>
    </HeroSplitLayout>
  </main>
</BaseLayout>
