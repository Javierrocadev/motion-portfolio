---
import '../styles/global.css';
import { getAlternateLinks, ROUTES, ROUTE_ORDER, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  lang?: Locale;
  route?: RouteKey;
  title?: string;
  description?: string;
  preloadImage?: string;
}

const {
  lang = 'es',
  route = 'home',
  title = 'Motion Portfolio',
  description = 'Portfolio built with Astro and CSS',
  preloadImage,
} = Astro.props;

const alternates = getAlternateLinks(route, Astro.site);
const canonicalHref = Astro.site ? new URL(ROUTES[route][lang], Astro.site).href : undefined;
const routeMapJson = JSON.stringify({ order: ROUTE_ORDER, routes: ROUTES });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const key = 'motion-portfolio:theme';
        const system = matchMedia('(prefers-color-scheme: dark)');
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
        const normalize = value => ['light', 'dark'].includes(value) ? value : 'system';
        const resolveTheme = pref => pref === 'system' ? (system.matches ? 'dark' : 'light') : pref;
        let preference = 'system';
        let switchTimer = 0;
        let activeTransition = null;
        try { preference = normalize(localStorage.getItem(key)); } catch {}
        const apply = (fallbackFade = false) => {
          const root = document.documentElement;
          if (fallbackFade && !reducedMotion.matches) {
            root.dataset.themeSwitching = 'true';
            window.clearTimeout(switchTimer);
            switchTimer = window.setTimeout(() => { delete root.dataset.themeSwitching; }, 440);
          }
          root.dataset.themePreference = preference;
          root.dataset.theme = resolveTheme(preference);
          document.querySelectorAll('[data-theme-option]').forEach(button => {
            button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference));
          });
        };
        const setPreference = (value, originEl) => {
          const next = normalize(value);
          if (next === preference) return;
          const root = document.documentElement;
          const prevTheme = root.dataset.theme || resolveTheme(preference);
          const nextTheme = resolveTheme(next);
          preference = next;
          try { localStorage.setItem(key, preference); } catch {}
          if (prevTheme === nextTheme || reducedMotion.matches) {
            apply(false);
            return;
          }
          if (typeof document.startViewTransition !== 'function') {
            apply(true);
            return;
          }
          const rect = originEl instanceof HTMLElement ? originEl.getBoundingClientRect() : null;
          const x = rect && rect.width > 0 ? rect.left + rect.width / 2 : window.innerWidth * 0.4;
          const y = rect && rect.height > 0 ? rect.top + rect.height / 2 : window.innerHeight - 36;
          const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          );
          root.dataset.themeTransition = 'true';
          const transition = document.startViewTransition(() => {
            apply(false);
          });
          activeTransition = transition;
          transition.ready
            .then(() => {
              root.animate(
                {
                  clipPath: [
                    `circle(0px at ${x}px ${y}px)`,
                    `circle(${endRadius}px at ${x}px ${y}px)`,
                  ],
                },
                {
                  duration: 820,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  pseudoElement: '::view-transition-new(root)',
                },
              );
            })
            .catch(() => {});
          transition.finished
            .catch(() => {})
            .finally(() => {
              if (activeTransition === transition) {
                delete root.dataset.themeTransition;
                activeTransition = null;
              }
            });
        };
        apply(false);
        document.addEventListener('DOMContentLoaded', () => apply(false));
        window.addEventListener('pageshow', () => apply(false));
        system.addEventListener('change', () => apply(false));
        document.addEventListener('click', event => {
          const target = event.target instanceof Element ? event.target.closest('[data-theme-option]') : null;
          if (!(target instanceof HTMLButtonElement)) return;
          setPreference(target.dataset.themeOption, target);
        });
        document.addEventListener('keydown', event => {
          const current = event.target instanceof Element ? event.target.closest('[data-theme-option]') : null;
          if (!(current instanceof HTMLButtonElement)) return;
          const switcher = current.closest('[data-theme-switcher]');
          if (!switcher) return;
          const buttons = Array.from(switcher.querySelectorAll('[data-theme-option]'));
          const index = buttons.indexOf(current);
          if (index === -1) return;
          let nextIndex = -1;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % buttons.length;
          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + buttons.length) % buttons.length;
          else if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = buttons.length - 1;
          if (nextIndex === -1) return;
          event.preventDefault();
          const nextButton = buttons[nextIndex];
          if (nextButton instanceof HTMLButtonElement) {
            nextButton.focus();
            setPreference(nextButton.dataset.themeOption, nextButton);
          }
        });
        window.addEventListener('storage', event => {
          if (event.key !== key && event.key !== null) return;
          preference = normalize(event.newValue);
          apply(false);
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="expect" href="#page-screen" blocking="render" />

    <script is:inline define:vars={{ routeMapJson }}>
      (() => {
        const STORAGE_KEY = 'motion-portfolio:last-path';
        const { order, routes } = JSON.parse(routeMapJson);

        // Keep infinite brand mark stroke animation phase-locked across MPA navigations.
        document.documentElement.style.setProperty('--brand-mark-phase', `-${Date.now() % 7000}ms`);

        const normalize = (pathname) => {
          const clean = String(pathname || '/').split(/[?#]/)[0] || '/';
          const prefixed = clean.startsWith('/') ? clean : '/' + clean;
          return prefixed.length > 1 ? prefixed.replace(/\/+$/, '') : '/';
        };

        const resolve = (pathname) => {
          const path = normalize(pathname);
          for (const key of order) {
            for (const loc of ['es', 'en']) {
              if (routes[key][loc] === path) return { route: key, locale: loc };
            }
          }
          return null;
        };

        const computeDirection = (fromPath, toPath) => {
          const from = resolve(fromPath);
          const to = resolve(toPath);
          if (!from || !to) return 'forward';
          if (from.route === to.route && from.locale !== to.locale) return 'locale-switch';
          return order.indexOf(to.route) >= order.indexOf(from.route) ? 'forward' : 'backward';
        };

        const isSameOriginReferrer = () => {
          try {
            return Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
          } catch {
            return false;
          }
        };

        const hasNavActivation = Boolean(window.navigation && window.navigation.activation && window.navigation.activation.from);
        if (hasNavActivation || isSameOriginReferrer()) {
          document.documentElement.dataset.navTransition = 'true';
        }

        window.addEventListener('pageswap', (event) => {
          try {
            sessionStorage.setItem(STORAGE_KEY, location.pathname);
          } catch {}
          if (!event.viewTransition) return;
          const targetUrl = event.activation && event.activation.entry && event.activation.entry.url;
          if (!targetUrl) return;
          try {
            const direction = computeDirection(location.pathname, new URL(targetUrl).pathname);
            event.viewTransition.types.add(direction);
          } catch {}
        });

        window.addEventListener('pagereveal', (event) => {
          let fromPath = null;
          if (window.navigation && window.navigation.activation && window.navigation.activation.from) {
            try {
              fromPath = new URL(window.navigation.activation.from.url).pathname;
            } catch {}
          }
          if (!fromPath) {
            try {
              fromPath = sessionStorage.getItem(STORAGE_KEY);
            } catch {}
          }

          if (event.viewTransition && fromPath) {
            document.documentElement.dataset.navTransition = 'true';
            const direction = computeDirection(fromPath, location.pathname);
            event.viewTransition.types.add(direction);
          }

          try {
            sessionStorage.removeItem(STORAGE_KEY);
          } catch {}
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
