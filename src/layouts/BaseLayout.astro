---
import '../styles/global.css';
import { getAlternateLinks, ROUTES, ROUTE_ORDER, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  lang?: Locale;
  route?: RouteKey;
  title?: string;
  description?: string;
  preloadImage?: string;
}

const {
  lang = 'es',
  route = 'home',
  title = 'Motion Portfolio',
  description = 'Portfolio built with Astro and CSS',
  preloadImage,
} = Astro.props;

const alternates = getAlternateLinks(route, Astro.site);
const canonicalHref = Astro.site ? new URL(ROUTES[route][lang], Astro.site).href : undefined;
const routeMapJson = JSON.stringify({ order: ROUTE_ORDER, routes: ROUTES });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="expect" href="#page-screen" blocking="render" />

    <script is:inline define:vars={{ routeMapJson }}>
      (() => {
        const STORAGE_KEY = 'motion-portfolio:last-path';
        const { order, routes } = JSON.parse(routeMapJson);

        // Keep infinite brand mark stroke animation phase-locked across MPA navigations.
        document.documentElement.style.setProperty('--brand-mark-phase', `-${Date.now() % 7000}ms`);

        const normalize = (pathname) => {
          const clean = String(pathname || '/').split(/[?#]/)[0] || '/';
          const prefixed = clean.startsWith('/') ? clean : '/' + clean;
          return prefixed.length > 1 ? prefixed.replace(/\/+$/, '') : '/';
        };

        const resolve = (pathname) => {
          const path = normalize(pathname);
          for (const key of order) {
            for (const loc of ['es', 'en']) {
              if (routes[key][loc] === path) return { route: key, locale: loc };
            }
          }
          return null;
        };

        const computeDirection = (fromPath, toPath) => {
          const from = resolve(fromPath);
          const to = resolve(toPath);
          if (!from || !to) return 'forward';
          if (from.route === to.route && from.locale !== to.locale) return 'locale-switch';
          return order.indexOf(to.route) >= order.indexOf(from.route) ? 'forward' : 'backward';
        };

        const isSameOriginReferrer = () => {
          try {
            return Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
          } catch {
            return false;
          }
        };

        const hasNavActivation = Boolean(window.navigation && window.navigation.activation && window.navigation.activation.from);
        if (hasNavActivation || isSameOriginReferrer()) {
          document.documentElement.dataset.navTransition = 'true';
        }

        window.addEventListener('pageswap', (event) => {
          try {
            sessionStorage.setItem(STORAGE_KEY, location.pathname);
          } catch {}
          if (!event.viewTransition) return;
          const targetUrl = event.activation && event.activation.entry && event.activation.entry.url;
          if (!targetUrl) return;
          try {
            const direction = computeDirection(location.pathname, new URL(targetUrl).pathname);
            event.viewTransition.types.add(direction);
          } catch {}
        });

        window.addEventListener('pagereveal', (event) => {
          let fromPath = null;
          if (window.navigation && window.navigation.activation && window.navigation.activation.from) {
            try {
              fromPath = new URL(window.navigation.activation.from.url).pathname;
            } catch {}
          }
          if (!fromPath) {
            try {
              fromPath = sessionStorage.getItem(STORAGE_KEY);
            } catch {}
          }

          if (event.viewTransition && fromPath) {
            document.documentElement.dataset.navTransition = 'true';
            const direction = computeDirection(fromPath, location.pathname);
            event.viewTransition.types.add(direction);
          }

          try {
            sessionStorage.removeItem(STORAGE_KEY);
          } catch {}
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
