---
import { Image } from 'astro:assets';
import mockImage from '../../assets/process/mock.jpeg';
import hifiImage from '../../assets/process/hifi.jpg';
import InteractiveButtonCard from '../process/InteractiveButtonCard.astro';
import type { Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const variantKeys = ['scale', 'slide', 'click'] as const;
---

<section class="panel-screen" data-process-screen aria-labelledby="process-heading">
  <div class="panel-screen__inner">
    <header class="panel-header">
      <p class="panel-eyebrow" data-screen-reveal style="--i: 0">{t.process.eyebrow}</p>
      <h1 id="process-heading" class="panel-title" data-screen-reveal style="--i: 1">{t.process.title}</h1>
      <p class="panel-subtitle" data-screen-reveal style="--i: 2">{t.process.subtitle}</p>
      <p class="panel-intro" data-screen-reveal style="--i: 3">{t.process.introPrimary}</p>
    </header>

    <!-- Evolution pipeline: Sketch -> Figma -> Interactive Code -->
    <section class="process-section" aria-labelledby="process-evolution-heading">
      <h2 id="process-evolution-heading" class="section-heading" data-screen-reveal style="--i: 4">
        {t.process.evolution.title}
      </h2>

      <div class="evolution-flow">
        <figure class="artifact-col" data-screen-reveal style="--i: 5">
          <div class="artifact-frame">
            <Image
              src={mockImage}
              alt={t.process.evolution.sketchAlt}
              widths={[320, 520]}
              sizes="(max-width: 900px) 70vw, 260px"
              loading="eager"
              class="artifact-image"
            />
          </div>
          <figcaption class="artifact-caption">{t.process.evolution.sketchLabel}</figcaption>
        </figure>

        <svg
          class="evolution-arrow"
          data-screen-reveal
          style="--i: 5"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M5 12h14" />
          <path d="M13 6l6 6-6 6" />
        </svg>

        <figure class="artifact-col" data-screen-reveal style="--i: 6">
          <div class="artifact-frame">
            <Image
              src={hifiImage}
              alt={t.process.evolution.hifiAlt}
              widths={[320, 520]}
              sizes="(max-width: 900px) 70vw, 260px"
              loading="eager"
              class="artifact-image"
            />
          </div>
          <figcaption class="artifact-caption">{t.process.evolution.hifiLabel}</figcaption>
        </figure>

        <svg
          class="evolution-arrow"
          data-screen-reveal
          style="--i: 6"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M5 12h14" />
          <path d="M13 6l6 6-6 6" />
        </svg>

        <figure class="artifact-col" data-screen-reveal style="--i: 7">
          <InteractiveButtonCard
            variant="showcase"
            ariaLabel={t.process.evolution.cardAriaLabel}
          />
          <figcaption class="artifact-caption">
            <span class="artifact-live-dot" aria-hidden="true"></span>
            <span>{t.process.evolution.codeLabel}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Code Variants Lab -->
    <section class="process-section" aria-labelledby="process-variants-heading" data-reveal>
      <div class="section-head">
        <h2 id="process-variants-heading" class="section-heading">
          {t.process.variants.title}
        </h2>
        <p class="section-lead">{t.process.introSecondary}</p>
      </div>

      <div class="variants-grid">
        {
          t.process.variants.items.map((item, idx) => (
            <figure class="artifact-col">
              <InteractiveButtonCard
                variant={variantKeys[idx]}
                ariaLabel={item.ariaLabel}
              />
              <figcaption class="artifact-caption">{item.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- User Journey -->
    <section
      class="process-section journey-section"
      aria-labelledby="process-journey-heading"
      data-journey-section
      data-reveal
    >
      <header class="section-head">
        <h2 id="process-journey-heading" class="section-heading">
          {t.process.journey.titleLead}{' '}
          <span class="section-heading__accent">{t.process.journey.titleAccent}</span>
        </h2>
        <p class="section-lead">{t.process.journey.description}</p>
      </header>

      <div class="journey-grid" data-journey-grid>
        <div class="journey-highlight" data-journey-highlight aria-hidden="true"></div>

        {
          t.process.journey.cards.map((card, idx) => (
            <article class="journey-card" data-journey-card={String(idx)}>
              <span class="journey-card__tag">{card.tag}</span>
              <h3 class="journey-card__title">{card.title}</h3>
              <p class="journey-card__desc">{card.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Design Skills & Principles -->
    <section
      class="process-section skills-section"
      aria-labelledby="process-principles-heading"
      data-reveal
    >
      <header class="section-head">
        <h2 id="process-principles-heading" class="section-heading">
          {t.process.skills.title}
        </h2>
        <p class="section-lead">{t.process.skills.subtitle}</p>
      </header>

      <ol class="principles-list">
        {
          t.process.principles.map((principle) => (
            <li class="principle-item">
              <span class="principle-item__label">{principle}</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</section>

<script>
  for (const screen of document.querySelectorAll<HTMLElement>('[data-process-screen]')) {
    const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const syncPaused = () => {
      screen.dataset.paused = String(document.hidden);
    };
    document.addEventListener('visibilitychange', syncPaused);
    syncPaused();

    // 1. Tap / click toggle for interactive CSS button cards
    const cards = [...screen.querySelectorAll<HTMLButtonElement>('[data-proto-card]')];

    const clearProtoCards = (except?: HTMLButtonElement) => {
      for (const card of cards) {
        if (card === except) continue;
        delete card.dataset.active;
        card.setAttribute('aria-pressed', 'false');
      }
    };

    for (const card of cards) {
      card.addEventListener('click', () => {
        const nextActive = card.dataset.active !== 'true';
        clearProtoCards(card);
        if (nextActive) {
          card.dataset.active = 'true';
        } else {
          delete card.dataset.active;
        }
        card.setAttribute('aria-pressed', String(nextActive));
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('[data-proto-card]')) return;
      clearProtoCards();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') clearProtoCards();
    });

    // 2. Sliding top hairline tracker for User Journey columns
    const journeyGrid = screen.querySelector<HTMLElement>('[data-journey-grid]');
    const highlight = screen.querySelector<HTMLElement>('[data-journey-highlight]');

    if (journeyGrid && highlight) {
      const journeyCards = [...journeyGrid.querySelectorAll<HTMLElement>('[data-journey-card]')];
      let activeJourneyCard: HTMLElement | null = null;

      const positionHighlight = (card: HTMLElement | null, immediate = false) => {
        if (!card) {
          highlight.style.opacity = '0';
          activeJourneyCard = null;
          return;
        }
        const rect = card.getBoundingClientRect();
        const gridRect = journeyGrid.getBoundingClientRect();
        if (rect.width === 0 || gridRect.width === 0) return;

        const snap = immediate || activeJourneyCard === null || prefersReducedMotion;
        if (snap) highlight.style.transition = 'none';
        highlight.style.width = `${rect.width}px`;
        highlight.style.transform = `translate3d(${rect.left - gridRect.left}px, ${rect.top - gridRect.top}px, 0)`;
        if (snap) {
          void highlight.offsetWidth;
          highlight.style.removeProperty('transition');
        }
        highlight.style.opacity = '1';
        activeJourneyCard = card;
      };

      for (const card of journeyCards) {
        card.addEventListener('pointerenter', () => positionHighlight(card));
      }

      journeyGrid.addEventListener('pointerleave', () => {
        positionHighlight(null);
      });

      const resizeObserver = new ResizeObserver(() => {
        if (activeJourneyCard) positionHighlight(activeJourneyCard, true);
      });
      resizeObserver.observe(journeyGrid);
    }

    // 3. Progressive below-the-fold scroll reveal
    const revealNodes = [...screen.querySelectorAll<HTMLElement>('[data-reveal]')];

    if (!prefersReducedMotion && 'IntersectionObserver' in window && revealNodes.length > 0) {
      const usePanelRoot = screen.scrollHeight > screen.clientHeight + 2;
      const rootBottom = usePanelRoot
        ? screen.getBoundingClientRect().bottom
        : window.innerHeight;

      const pendingNodes = revealNodes.filter((node) => {
        const rect = node.getBoundingClientRect();
        return rect.top > rootBottom - 24;
      });

      if (pendingNodes.length > 0) {
        for (const node of pendingNodes) {
          node.dataset.reveal = 'pending';
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const target = entry.target as HTMLElement;
              target.dataset.reveal = 'visible';
              observer.unobserve(target);
            }
          },
          {
            root: usePanelRoot ? screen : null,
            threshold: 0.08,
            rootMargin: '0px 0px -24px 0px',
          },
        );

        for (const node of pendingNodes) {
          observer.observe(node);
        }
      }
    }
  }
</script>

<style>
  .panel-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--fg-rgb), 0.16) transparent;
    background-color: var(--bg);
    padding-block-start: calc(var(--panel-pad-block) + 3.45rem);
    padding-block-end: clamp(2.25rem, 4.5dvw, 3.75rem);
    padding-inline: var(--panel-pad-inline);
  }

  .panel-screen__inner {
    inline-size: 100%;
    container-type: inline-size;
    container-name: process;
    display: grid;
    gap: clamp(2.5rem, 4.8dvw, 3.75rem);
  }

  /* Header */
  .panel-header {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .panel-eyebrow {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-title {
    font-size: clamp(2.05rem, 4vw, 3.35rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--fg);
    text-wrap: balance;
  }

  .panel-subtitle {
    font-size: clamp(1.06rem, 1.7vw, 1.35rem);
    font-weight: 400;
    color: rgba(var(--fg-rgb), 0.72);
    letter-spacing: -0.015em;
  }

  .panel-intro {
    margin-block-start: 0.4rem;
    max-inline-size: 40rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(var(--fg-rgb), 0.68);
  }

  /* Shared unboxed section rhythm */
  .process-section {
    border-block-start: 1px solid var(--line);
    padding-block-start: clamp(1.5rem, 3cqi, 2.25rem);
    display: grid;
    gap: clamp(1.25rem, 2.6cqi, 1.85rem);
  }

  .section-head {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
    text-align: left;
  }

  .section-heading {
    font-size: clamp(1.25rem, 2.1vw, 1.65rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: balance;
  }

  .section-heading__accent {
    color: rgba(var(--fg-rgb), 0.56);
  }

  .section-lead {
    max-inline-size: 40rem;
    font-size: 0.94rem;
    line-height: 1.66;
    color: rgba(var(--fg-rgb), 0.68);
  }

  /* Artifacts directly on bare canvas */
  .evolution-flow {
    display: grid;
    grid-template-columns: minmax(0, 16.5rem);
    justify-content: center;
    justify-items: center;
    gap: 1rem;
  }

  .variants-grid {
    display: grid;
    grid-template-columns: minmax(0, 16.5rem);
    justify-content: center;
    gap: 1.35rem;
  }

  .artifact-col {
    width: 100%;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .artifact-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background-color: var(--bg);
    box-shadow: none;
  }

  .artifact-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artifact-caption {
    display: flex;
    align-items: center;
    gap: 0.48rem;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--muted);
  }

  .artifact-live-dot {
    position: relative;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background-color: var(--fg);
    flex-shrink: 0;
  }

  .evolution-arrow {
    color: rgba(var(--fg-rgb), 0.32);
    transform: rotate(90deg);
  }

  @container process (min-width: 34rem) {
    .evolution-flow {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
      justify-content: stretch;
      align-items: center;
      gap: clamp(0.6rem, 1.8cqi, 1.25rem);
    }

    .evolution-arrow {
      transform: none;
      margin-block-end: 1.45rem;
    }

    .variants-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      justify-content: stretch;
      gap: clamp(0.9rem, 2.2cqi, 1.5rem);
    }
  }

  /* User Journey — unboxed open columns with sliding top hairline */
  .journey-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background: transparent;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }

  @container process (min-width: 36rem) {
    .journey-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.25rem, 2.8cqi, 2.25rem);
    }
  }

  .journey-highlight {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 2;
    block-size: 1.5px;
    background-color: var(--fg);
    pointer-events: none;
    opacity: 0;
  }

  .journey-card {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
    padding-block: 1.1rem 0.25rem;
    border-block-start: 1px solid var(--line);
    background-color: transparent;
  }

  .journey-card__tag {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .journey-card__title {
    font-size: 1.22rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .journey-card__desc {
    font-size: 0.89rem;
    line-height: 1.62;
    color: rgba(var(--fg-rgb), 0.68);
  }

  /* Design Skills & Principles — architectural hairline list */
  .principles-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
  }

  .principle-item {
    position: relative;
    display: flex;
    align-items: center;
    padding-block: 0.95rem;
    border-block-end: 1px solid var(--line);
    color: rgba(var(--fg-rgb), 0.88);
  }

  .principle-item:first-child {
    border-block-start: 1px solid var(--line);
  }

  .principle-item::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
    background-color: var(--fg);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  .principle-item__label {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  @container process (min-width: 34rem) {
    .principles-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.75rem, 4cqi, 3.25rem);
    }

    .principle-item:nth-child(-n + 2) {
      border-block-start: 1px solid var(--line);
    }
  }

  @media (hover: hover) {
    .journey-grid:has(.journey-card:hover) .journey-card:not(:hover) {
      opacity: 0.48;
    }

    .journey-card:hover .journey-card__tag {
      color: var(--fg);
    }

    .principles-list:has(.principle-item:hover) .principle-item:not(:hover) {
      opacity: 0.52;
    }

    .principle-item:hover {
      color: var(--fg);
    }

    .principle-item:hover::after {
      transform: scaleX(1);
    }

    .principle-item:hover .principle-item__label {
      transform: translateX(4px);
    }
  }

  /* Smooth editorial transitions & below-the-fold scroll reveals */
  @keyframes processLivePulse {
    0% {
      opacity: 0.6;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .artifact-live-dot::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: inherit;
      border: 1px solid rgba(var(--fg-rgb), 0.45);
      pointer-events: none;
      animation: processLivePulse 2.6s var(--ease-editorial) infinite;
    }

    [data-paused='true'] .artifact-live-dot::after {
      animation-play-state: paused;
    }

    [data-reveal='pending'] {
      opacity: 0;
      transform: translateY(16px);
    }

    [data-reveal='visible'] {
      opacity: 1;
      transform: none;
      transition:
        opacity 640ms var(--ease-editorial),
        transform 640ms var(--ease-editorial);
    }

    [data-reveal='pending'] :is(.artifact-col, .journey-card, .principle-item) {
      opacity: 0;
      translate: 0 16px;
    }

    [data-reveal='visible'] :is(.artifact-col, .journey-card, .principle-item) {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 560ms var(--ease-editorial),
        translate 560ms var(--ease-editorial);
    }

    [data-reveal='visible'] .variants-grid .artifact-col:nth-of-type(2),
    [data-reveal='visible'] .journey-grid .journey-card:nth-of-type(2),
    [data-reveal='visible'] .principles-list .principle-item:nth-of-type(2) {
      transition-delay: 75ms;
    }

    [data-reveal='visible'] .variants-grid .artifact-col:nth-of-type(3),
    [data-reveal='visible'] .journey-grid .journey-card:nth-of-type(3),
    [data-reveal='visible'] .principles-list .principle-item:nth-of-type(3) {
      transition-delay: 150ms;
    }

    [data-reveal='visible'] .principles-list .principle-item:nth-of-type(4) {
      transition-delay: 200ms;
    }

    [data-reveal='visible'] .principles-list .principle-item:nth-of-type(5) {
      transition-delay: 240ms;
    }

    [data-reveal='visible'] .principles-list .principle-item:nth-of-type(6) {
      transition-delay: 280ms;
    }

    .artifact-frame {
      transition: border-color 280ms var(--ease-editorial);
    }

    .artifact-frame:hover {
      border-color: rgba(var(--fg-rgb), 0.28);
    }

    .artifact-image {
      transition: transform 520ms var(--ease-editorial);
    }

    .artifact-frame:hover .artifact-image {
      transform: scale(1.025);
    }

    .journey-highlight {
      transition:
        transform 360ms var(--ease-editorial),
        width 360ms var(--ease-editorial),
        opacity 220ms ease;
    }

    .journey-card {
      transition: opacity 260ms var(--ease-editorial);
    }

    .journey-card__tag {
      transition: color 240ms var(--ease-editorial);
    }

    .principle-item {
      transition:
        opacity 240ms var(--ease-editorial),
        color 240ms var(--ease-editorial);
    }

    .principle-item::after {
      transition: transform 340ms var(--ease-editorial);
    }

    .principle-item__label {
      transition: transform 280ms var(--ease-editorial);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal='pending'],
    [data-reveal='pending'] :is(.artifact-col, .journey-card, .principle-item) {
      opacity: 1;
      transform: none;
      translate: none;
    }

    .artifact-live-dot::after {
      animation: none;
    }

    .artifact-frame,
    .artifact-image,
    .journey-highlight,
    .journey-card,
    .journey-card__tag,
    .principle-item,
    .principle-item::after,
    .principle-item__label {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .process-section,
    .artifact-frame,
    .journey-card,
    .principle-item {
      border-color: CanvasText;
    }

    .journey-highlight,
    .principle-item::after {
      background-color: Highlight;
    }
  }
</style>
