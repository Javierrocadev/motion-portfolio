---
import type { ProjectItem } from '../../data/projects';
import type { Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
  projects: ProjectItem[];
}

const { locale, projects } = Astro.props;
const t = getTranslations(locale);

const posterFor = (project: ProjectItem) =>
  project.image?.src ??
  (project.video?.endsWith('/8d90945dc01903446d2fb84dc7601e6b194785e3.mp4')
    ? '/posters/website-promo.webp'
    : undefined);

const splitCategories = (category: string) =>
  category
    .split('·')
    .map((part) => part.trim())
    .filter(Boolean);

const categoryCounts = Array.from(
  projects.reduce((acc, project) => {
    for (const cat of splitCategories(project.category)) {
      acc.set(cat, (acc.get(cat) ?? 0) + 1);
    }
    return acc;
  }, new Map<string, number>()),
);
---

<section class="panel-screen" aria-labelledby="projects-heading">
  <div class="panel-screen__inner">
    <header class="panel-header">
      <p class="panel-eyebrow">{t.projects.eyebrow}</p>
      <div class="panel-title-row">
        <h1 id="projects-heading" class="panel-title">{t.projects.title}</h1>
        <span
          class="panel-count"
          data-projects-count
          data-total={projects.length}
          data-count-label={t.projects.countLabel}
        >
          {String(projects.length).padStart(2, '0')} · {t.projects.countLabel}
        </span>
      </div>
      <p class="panel-intro">{t.projects.intro}</p>
    </header>

    {categoryCounts.length > 1 && (
      <div class="projects-filters" role="group" aria-label={t.projects.filterAriaLabel} data-projects-filters>
        <button type="button" class="filter-chip" data-filter="__all__" aria-pressed="true">
          <span>{t.projects.allFilter}</span>
          <span class="filter-chip__count">{projects.length}</span>
        </button>
        {categoryCounts.map(([category, count]) => (
          <button type="button" class="filter-chip" data-filter={category} aria-pressed="false">
            <span>{category}</span>
            <span class="filter-chip__count">{count}</span>
          </button>
        ))}
      </div>
    )}

    <ol class="projects-list">
      {
        projects.map((project) => {
          const poster = posterFor(project);
          const soft = project.image?.softTone ?? '#47464a';
          const dark = project.image?.darkTone ?? '#202024';
          const categories = splitCategories(project.category);
          return (
            <li
              class="project-row"
              id={'project-' + project.id}
              tabindex="-1"
              data-project-row
              data-categories={categories.join('|')}
              style={{ '--tone-soft': soft, '--tone-dark': dark }}
            >
              <div class="project-row__thumb">
                {poster ? (
                  <img
                    src={poster}
                    alt={project.image?.alt || project.title}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="project-row__placeholder">{project.index}</span>
                )}
                <span class="project-row__thumb-index">{project.index}</span>
                {(project.video || project.demoUrl) && (
                  <div class="project-row__thumb-badges" aria-hidden="true">
                    {project.video && (
                      <span class="project-row__thumb-badge project-row__thumb-badge--motion">
                        <span class="project-row__motion-dot"></span>
                        {t.projects.videoBadge}
                      </span>
                    )}
                    {project.demoUrl && (
                      <span class="project-row__thumb-badge">{t.projects.demoBadge}</span>
                    )}
                  </div>
                )}
              </div>

              <div class="project-row__body">
                {categories.length > 0 && (
                  <div class="project-row__meta">
                    {categories.map((cat) => (
                      <span class="project-row__tag">{cat}</span>
                    ))}
                  </div>
                )}

                <h2 class="project-row__title">{project.title}</h2>
                {project.summary && (
                  <p class="project-row__summary">{project.summary}</p>
                )}

                {(project.url || project.demoUrl) && (
                  <div class="project-row__actions">
                    {project.url && (
                      <a
                        class="project-row__link"
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span>{t.projects.visitProject}</span>
                        <span class="project-row__arrow" aria-hidden="true">↗</span>
                      </a>
                    )}
                    {project.demoUrl && (
                      <a
                        class="project-row__demo-link"
                        href={project.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span>{t.projects.openDemo}</span>
                        <span class="project-row__arrow" aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  for (const filterBar of document.querySelectorAll<HTMLElement>('[data-projects-filters]')) {
    const scope = filterBar.closest<HTMLElement>('.panel-screen__inner');
    if (!scope) continue;
    const buttons = [...filterBar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...scope.querySelectorAll<HTMLElement>('[data-project-row]')];
    const counter = scope.querySelector<HTMLElement>('[data-projects-count]');
    const total = Number(counter?.dataset.total ?? rows.length);
    const countLabel = counter?.dataset.countLabel ?? '';

    const applyFilter = (selected: string) => {
      for (const btn of buttons) {
        btn.setAttribute('aria-pressed', String(btn.dataset.filter === selected));
      }
      let visible = 0;
      for (const row of rows) {
        const categories = (row.dataset.categories ?? '').split('|').filter(Boolean);
        const matches = selected === '__all__' || categories.includes(selected);
        row.hidden = !matches;
        if (matches) visible += 1;
      }
      if (counter) {
        const totalStr = String(total).padStart(2, '0');
        const visibleStr = String(visible).padStart(2, '0');
        counter.textContent = selected === '__all__'
          ? `${totalStr} · ${countLabel}`
          : `${visibleStr} / ${totalStr} · ${countLabel}`;
      }
    };

    filterBar.addEventListener('click', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      applyFilter(btn.dataset.filter ?? '__all__');
    });

    window.addEventListener('hashchange', () => {
      const id = location.hash.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (target && target.hidden) {
        applyFilter('__all__');
        target.scrollIntoView({ block: 'center' });
      }
    });
  }
</script>

<style>
  .panel-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    background-color: var(--bg);
    padding-block-start: calc(var(--panel-pad-block) + 3.45rem);
    padding-block-end: clamp(1.5rem, 2.5dvw, 2.25rem);
    padding-inline: var(--panel-pad-inline);
  }

  .panel-screen__inner {
    inline-size: 100%;
    display: grid;
    gap: clamp(1.25rem, 2.2dvw, 1.85rem);
  }

  .panel-header {
    display: grid;
    gap: 0.65rem;
    padding-block-end: 1.1rem;
    border-block-end: 1px solid var(--line);
  }

  .panel-eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .panel-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .panel-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-intro {
    max-inline-size: 42rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(var(--fg-rgb), 0.76);
  }

  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-block-size: 2rem;
    padding-block: 0.34rem;
    padding-inline: 0.78rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: var(--surface);
    color: rgba(var(--fg-rgb), 0.78);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    touch-action: manipulation;
  }

  .filter-chip:hover {
    border-color: rgba(var(--fg-rgb), 0.28);
    color: var(--fg);
  }

  .filter-chip[aria-pressed='true'] {
    background-color: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .filter-chip__count {
    font-variant-numeric: tabular-nums;
    font-size: 0.7rem;
    opacity: 0.62;
  }

  .filter-chip[aria-pressed='true'] .filter-chip__count {
    opacity: 0.78;
  }

  .filter-chip:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .projects-list {
    list-style: none;
    display: grid;
    gap: 1.15rem;
  }

  .project-row[hidden] {
    display: none;
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 14.5rem) minmax(0, 1fr);
    gap: 1.2rem 1.5rem;
    align-items: center;
    padding: 0.95rem;
    border-radius: 0.95rem;
    border: 1px solid var(--line);
    background-color: var(--surface);
  }

  .project-row:hover {
    border-color: color-mix(in srgb, var(--tone-soft, var(--fg)) 42%, var(--line));
    box-shadow: 0 12px 32px rgb(0 0 0 / 24%);
  }

  :global(:root[data-theme='light']) .project-row:hover {
    box-shadow: 0 12px 28px rgb(0 0 0 / 7%);
  }

  .project-row__thumb {
    --in-oklab: ;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 0.62rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 0.55rem;
    background: linear-gradient(145deg var(--in-oklab), var(--tone-soft), var(--tone-dark));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 12%);
  }

  @supports (background: linear-gradient(in oklab, white, black)) {
    .project-row__thumb {
      --in-oklab: in oklab;
    }
  }

  .project-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-row:hover .project-row__thumb img {
    transform: scale(1.045);
  }

  .project-row__placeholder {
    font-variant-numeric: tabular-nums;
    font-size: 1.35rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
  }

  .project-row__thumb-index {
    position: absolute;
    inset-block-start: 0.45rem;
    inset-inline-start: 0.45rem;
    padding: 0.16rem 0.42rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background-color: rgba(9, 9, 11, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.94);
    font-variant-numeric: tabular-nums;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .project-row__thumb-badges {
    position: absolute;
    inset-block-end: 0.45rem;
    inset-inline-end: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    pointer-events: none;
  }

  .project-row__thumb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.16rem 0.46rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background-color: rgba(9, 9, 11, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .project-row__motion-dot {
    width: 4.5px;
    height: 4.5px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.92);
  }

  .project-row__body {
    display: grid;
    gap: 0.48rem;
    min-inline-size: 0;
  }

  .project-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .project-row__tag {
    padding-block: 0.16rem;
    padding-inline: 0.52rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: rgba(var(--fg-rgb), 0.04);
    color: rgba(var(--fg-rgb), 0.76);
    font-size: 0.71rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .project-row__title {
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .project-row__summary {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(var(--fg-rgb), 0.74);
  }

  .project-row__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    margin-block-start: 0.3rem;
  }

  .project-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    border-block-end: 1px solid rgba(var(--fg-rgb), 0.3);
    padding-block-end: 0.12rem;
  }

  .project-row__link:hover {
    border-color: var(--fg);
  }

  .project-row__demo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.28rem;
    padding-inline: 0.68rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: rgba(var(--fg-rgb), 0.05);
    color: var(--fg);
    font-size: 0.76rem;
    font-weight: 500;
    text-decoration: none;
  }

  .project-row__demo-link:hover {
    border-color: rgba(var(--fg-rgb), 0.34);
    background-color: rgba(var(--fg-rgb), 0.1);
  }

  .project-row__link:focus-visible,
  .project-row__demo-link:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .project-row__arrow {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter-chip {
      transition:
        background-color 180ms var(--ease-editorial),
        border-color 180ms var(--ease-editorial),
        color 180ms var(--ease-editorial);
    }

    .project-row {
      transition:
        border-color 220ms var(--ease-editorial),
        box-shadow 260ms var(--ease-editorial),
        background-color 220ms var(--ease-editorial);
    }

    .project-row__thumb img {
      transition: transform 380ms var(--ease-editorial);
    }

    .project-row__link,
    .project-row__demo-link {
      transition:
        border-color 180ms ease,
        background-color 180ms ease,
        opacity 180ms ease;
    }

    .project-row__arrow {
      transition: transform 180ms var(--ease-editorial);
    }

    .project-row__link:hover .project-row__arrow,
    .project-row__demo-link:hover .project-row__arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (forced-colors: active) {
    .filter-chip[aria-pressed='true'] {
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
    .project-row__thumb-index,
    .project-row__thumb-badge {
      background: Canvas;
      color: CanvasText;
      border-color: CanvasText;
      backdrop-filter: none;
    }
  }

  @media (max-width: 680px) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }
</style>
