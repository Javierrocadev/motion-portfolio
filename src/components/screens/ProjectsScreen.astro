---
import type { ProjectItem } from '../../data/projects';
import type { Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
  projects: ProjectItem[];
}

const { locale, projects } = Astro.props;
const t = getTranslations(locale);

const posterFor = (project: ProjectItem) =>
  project.image?.src ??
  (project.video?.endsWith('/8d90945dc01903446d2fb84dc7601e6b194785e3.mp4')
    ? '/posters/website-promo.webp'
    : undefined);
---

<section class="panel-screen" aria-labelledby="projects-heading">
  <div class="panel-screen__inner">
    <header class="panel-header">
      <p class="panel-eyebrow">{t.projects.eyebrow}</p>
      <div class="panel-title-row">
        <h1 id="projects-heading" class="panel-title">{t.projects.title}</h1>
        <span class="panel-count">
          {String(projects.length).padStart(2, '0')} · {t.projects.countLabel}
        </span>
      </div>
      <p class="panel-intro">{t.projects.intro}</p>
    </header>

    <ol class="projects-list">
      {
        projects.map((project) => {
          const poster = posterFor(project);
          const soft = project.image?.softTone ?? '#47464a';
          const dark = project.image?.darkTone ?? '#202024';
          return (
            <li class="project-row" id={'project-' + project.id} tabindex="-1">
              <div
                class="project-row__thumb"
                style={{ '--tone-soft': soft, '--tone-dark': dark }}
              >
                {poster ? (
                  <img
                    src={poster}
                    alt={project.image?.alt || project.title}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="project-row__placeholder">{project.index}</span>
                )}
              </div>

              <div class="project-row__body">
                <div class="project-row__meta">
                  <span class="project-row__index">{project.index}</span>
                  {project.category && (
                    <span class="project-row__category">{project.category}</span>
                  )}
                  {project.video && (
                    <span class="project-row__badge">{t.projects.videoBadge}</span>
                  )}
                </div>

                <h2 class="project-row__title">{project.title}</h2>
                {project.summary && (
                  <p class="project-row__summary">{project.summary}</p>
                )}

                {project.url && (
                  <a
                    class="project-row__link"
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{t.projects.visitProject}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .panel-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    background-color: var(--bg);
    padding-block-start: calc(clamp(1.25rem, 2.8vw, 2.5rem) + 4.75rem);
    padding-block-end: clamp(2.5rem, 5vw, 4.5rem);
    padding-inline: clamp(1.5rem, 3.6vw, 3.25rem);
  }

  .panel-screen__inner {
    max-inline-size: 56rem;
    display: grid;
    gap: clamp(2rem, 3.5vw, 3rem);
  }

  .panel-header {
    display: grid;
    gap: 0.75rem;
    padding-block-end: 1.5rem;
    border-block-end: 1px solid var(--line);
  }

  .panel-eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .panel-title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .panel-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-intro {
    max-inline-size: 42rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(244, 244, 245, 0.76);
  }

  .projects-list {
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
    align-items: center;
    padding: 1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--line);
    background-color: var(--surface);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .project-row:hover {
    border-color: rgba(244, 244, 245, 0.22);
    background-color: #15151a;
  }

  .project-row__thumb {
    --in-oklab: ;
    aspect-ratio: 16 / 10;
    border-radius: 0.55rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 0.5rem;
    background: linear-gradient(145deg var(--in-oklab), var(--tone-soft), var(--tone-dark));
  }

  @supports (background: linear-gradient(in oklab, white, black)) {
    .project-row__thumb {
      --in-oklab: in oklab;
    }
  }

  .project-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project-row__placeholder {
    font-variant-numeric: tabular-nums;
    font-size: 1.25rem;
    font-weight: 500;
    color: rgba(244, 244, 245, 0.7);
  }

  .project-row__body {
    display: grid;
    gap: 0.45rem;
    min-inline-size: 0;
  }

  .project-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project-row__index {
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .project-row__badge {
    padding-block: 0.14rem;
    padding-inline: 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 244, 245, 0.2);
    color: var(--fg);
    font-size: 0.66rem;
  }

  .project-row__title {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .project-row__summary {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(244, 244, 245, 0.74);
  }

  .project-row__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-block-start: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    border-block-end: 1px solid rgba(244, 244, 245, 0.3);
    padding-block-end: 0.12rem;
    transition: border-color 180ms ease, opacity 180ms ease;
  }

  .project-row__link:hover {
    border-color: var(--fg);
  }

  .project-row__link:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 680px) {
    .project-row {
      grid-template-columns: 1fr;
    }
  }
</style>
