---
import { getLocalizedPath, type Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const processHref = getLocalizedPath('process', locale);
---

<section class="panel-screen" aria-labelledby="about-heading">
  <div class="panel-screen__inner">
    <header class="panel-header">
      <p class="panel-eyebrow">{t.about.eyebrow}</p>
      <h1 id="about-heading" class="panel-title">{t.about.title}</h1>
      <p class="panel-subtitle">{t.about.subtitle}</p>
    </header>

    <dl class="facts-grid">
      <div class="fact-card">
        <dt>{t.about.rolesLabel}</dt>
        <dd>{t.about.rolesValue}</dd>
      </div>
      <div class="fact-card">
        <dt>{t.about.hobbiesLabel}</dt>
        <dd>{t.about.hobbiesValue}</dd>
      </div>
    </dl>

    <div class="story-grid">
      <article class="story-block">
        <h2>{t.about.originTitle}</h2>
        <p>{t.about.originText}</p>
      </article>

      <article class="story-block">
        <h2>{t.about.nowTitle}</h2>
        <p>{t.about.nowText}</p>
        <a href={processHref} class="story-cta">
          <span>{t.about.processCta}</span>
          <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>

    <footer class="connect-block" aria-labelledby="connect-heading">
      <h2 id="connect-heading" class="section-label">{t.about.linksTitle}</h2>
      <div class="connect-row">
        <ul class="social-links">
          <li>
            <a
              href="https://www.linkedin.com/in/javierrocap/"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://uiverse.io/profile/Javierrocadev"
              target="_blank"
              rel="noopener noreferrer"
            >
              Uiverse <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Javierrocadev/"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

        <button
          type="button"
          class="copy-email"
          data-copy-email="javierroca.dev@gmail.com"
          aria-label={t.about.copyEmailAria}
          data-success={t.about.copySuccess}
          data-error={t.about.copyError}
        >
          <span>javierroca.dev@gmail.com</span>
          <span class="copy-email__state" data-copy-feedback aria-hidden="true"></span>
        </button>
        <span class="sr-only" data-copy-status role="status" aria-live="polite"></span>
      </div>
    </footer>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-email]')) {
    const container = button.parentElement;
    const status = container?.querySelector<HTMLElement>('[data-copy-status]');
    const feedback = button.querySelector<HTMLElement>('[data-copy-feedback]');
    let resetTimer = 0;

    button.addEventListener('click', async () => {
      const email = button.dataset.copyEmail ?? '';
      const successText = button.dataset.success ?? 'Copied';
      const errorText = button.dataset.error ?? 'Error';
      window.clearTimeout(resetTimer);

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(email);
        } else {
          const field = document.createElement('textarea');
          field.value = email;
          field.readOnly = true;
          field.style.cssText = 'position:fixed;inset:0;opacity:0;pointer-events:none';
          document.body.append(field);
          try {
            field.select();
            if (!document.execCommand('copy')) throw new Error('Copy failed');
          } finally {
            field.remove();
            button.focus({ preventScroll: true });
          }
        }
        button.classList.add('is-copied');
        if (feedback) feedback.textContent = `· ${successText}`;
        if (status) status.textContent = successText;
        resetTimer = window.setTimeout(() => {
          button.classList.remove('is-copied');
          if (feedback) feedback.textContent = '';
          if (status) status.textContent = '';
        }, 2200);
      } catch {
        button.classList.remove('is-copied');
        if (feedback) feedback.textContent = `· ${errorText}`;
        if (status) status.textContent = errorText;
      }
    });
  }
</script>

<style>
  .panel-screen {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    background-color: var(--bg);
    padding-block-start: calc(var(--panel-pad-block) + 3.45rem);
    padding-block-end: clamp(1.5rem, 2.5dvw, 2.25rem);
    padding-inline: var(--panel-pad-inline);
  }

  .panel-screen__inner {
    inline-size: 100%;
    display: grid;
    gap: clamp(1.35rem, 2.4dvw, 2rem);
  }

  .panel-header {
    display: grid;
    gap: 0.6rem;
    padding-block-end: 1.1rem;
    border-block-end: 1px solid var(--line);
  }

  .panel-eyebrow,
  .section-label {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .panel-title {
    font-size: clamp(1.95rem, 3.8vw, 3.25rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .panel-subtitle {
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    color: rgba(244, 244, 245, 0.8);
    letter-spacing: -0.015em;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .fact-card {
    display: grid;
    gap: 0.4rem;
    padding: 1.15rem 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--line);
    background-color: var(--surface);
  }

  .fact-card dt {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .fact-card dd {
    font-size: 0.94rem;
    color: var(--fg);
    line-height: 1.5;
  }

  .story-grid {
    display: grid;
    gap: 1.5rem;
  }

  .story-block {
    display: grid;
    gap: 0.65rem;
  }

  .story-block h2 {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .story-block p {
    max-inline-size: 44rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgba(244, 244, 245, 0.76);
  }

  .story-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 0.35rem;
    padding-block: 0.55rem;
    padding-inline: 1rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 244, 245, 0.22);
    background-color: rgba(244, 244, 245, 0.06);
    color: var(--fg);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .story-cta:hover {
    background-color: rgba(244, 244, 245, 0.14);
    border-color: rgba(244, 244, 245, 0.4);
  }

  .story-cta:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .connect-block {
    display: grid;
    gap: 0.9rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }

  .connect-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
  }

  .social-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.88rem;
    color: rgba(244, 244, 245, 0.8);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .social-links a:hover {
    color: var(--fg);
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .copy-email {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.48rem;
    padding-inline: 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  .copy-email:hover {
    border-color: rgba(244, 244, 245, 0.28);
    background-color: #18181e;
  }

  .copy-email.is-copied {
    border-color: rgba(244, 244, 245, 0.5);
  }

  .copy-email:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  .copy-email__state {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
