---
import type { Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = getTranslations(locale);

const options = [
  {
    value: 'system',
    ariaLabel: t.theme.systemAria,
  },
  {
    value: 'light',
    ariaLabel: t.theme.lightAria,
  },
  {
    value: 'dark',
    ariaLabel: t.theme.darkAria,
  },
] as const;
---

<div
  class="theme-switcher"
  data-theme-switcher
  role="group"
  aria-label={t.theme.groupLabel}
>
  <div class="theme-switcher__track">
    <span class="theme-switcher__thumb" aria-hidden="true"></span>
    {
      options.map((option) => (
        <button
          type="button"
          class="theme-switcher__btn"
          data-theme-option={option.value}
          aria-label={option.ariaLabel}
          aria-pressed="false"
        >
          {option.value === 'system' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--system"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.75" />
              <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor" />
            </svg>
          )}
          {option.value === 'light' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--light"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.75" />
              <path
                d="M12 2.75v2.25M12 19v2.25M4.93 4.93l1.6 1.6M17.47 17.47l1.6 1.6M2.75 12H5M19 12h2.25M4.93 19.07l1.6-1.6M17.47 6.53l1.6-1.6"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          )}
          {option.value === 'dark' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--dark"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M20.25 14.35A8.25 8.25 0 0 1 9.65 3.75a8.25 8.25 0 1 0 10.6 10.6Z"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </button>
      ))
    }
  </div>
</div>

<script>
  for (const switcher of document.querySelectorAll<HTMLElement>('[data-theme-switcher]')) {
    // Touch cannot hover, and tapping a button does not focus it in every browser.
    switcher.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch') switcher.dataset.touchOpen = 'true';
    });

    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !switcher.contains(event.target)) {
        delete switcher.dataset.touchOpen;
      }
    });

    switcher.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') delete switcher.dataset.touchOpen;
    });
  }
</script>

<style>
  .theme-switcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin-inline-start: auto;
    pointer-events: auto;
  }

  .theme-switcher__track {
    position: relative;
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }

  /* Keep the gaps hoverable without reserving space or exposing hidden controls. */
  .theme-switcher__track::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: 7.5rem;
    pointer-events: none;
  }

  .theme-switcher__thumb {
    position: absolute;
    inset-block: 3px;
    inset-inline-end: 3px;
    inline-size: calc(2.5rem - 6px);
    border-radius: 999px;
    background-color: var(--fg);
    box-shadow: 0 1px 4px rgba(var(--bg-rgb), 0.3);
    pointer-events: none;
  }

  .theme-switcher__btn {
    --theme-offset: -2.5rem;
    position: absolute;
    inset-block-start: 3px;
    inset-inline-end: 3px;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: calc(2.5rem - 6px);
    block-size: calc(2.5rem - 6px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 14px rgba(var(--bg-rgb), 0.18);
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(0) scale(0.95);
    transition: color 220ms var(--ease-editorial), background-color 180ms ease;
  }

  .theme-switcher__btn[data-theme-option='system'],
  :global(:root[data-theme-preference='system']) .theme-switcher__btn[data-theme-option='light'] {
    --theme-offset: -5rem;
  }

  .theme-switcher:has(:focus-visible) {
    .theme-switcher__track::before { pointer-events: auto; }
    .theme-switcher__btn {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(var(--theme-offset));
      transition: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-switcher:hover {
      .theme-switcher__track::before { pointer-events: auto; }
      .theme-switcher__btn {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(var(--theme-offset));
      }
    }

    .theme-switcher__btn:hover {
      color: var(--fg);
      background-color: var(--surface);
    }
  }

  .theme-switcher[data-touch-open='true'] {
    .theme-switcher__track::before { pointer-events: auto; }
    .theme-switcher__btn {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(var(--theme-offset));
    }
  }

  :global(:root[data-theme-preference='system']) .theme-switcher__btn[data-theme-option='system'],
  :global(:root[data-theme-preference='light']) .theme-switcher__btn[data-theme-option='light'],
  :global(:root[data-theme-preference='dark']) .theme-switcher__btn[data-theme-option='dark'],
  .theme-switcher__btn[aria-pressed='true'] {
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    color: var(--bg);
    background-color: transparent;
  }

  .theme-switcher__btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    z-index: 2;
  }

  .theme-switcher__icon {
    display: block;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-switcher__btn {
      transition:
        transform 220ms var(--ease-editorial),
        opacity 160ms ease,
        visibility 220ms,
        color 220ms var(--ease-editorial),
        background-color 180ms ease;
    }

    .theme-switcher__icon {
      transition: transform 220ms var(--ease-editorial), scale 160ms var(--ease-editorial);
    }

    .theme-switcher__btn:active .theme-switcher__icon {
      scale: 0.88;
    }

    :global(:root[data-theme-preference='system']) .theme-switcher__btn[data-theme-option='system'] .theme-switcher__icon--system,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--system {
      transform: rotate(180deg);
    }

    :global(:root[data-theme-preference='light']) .theme-switcher__btn[data-theme-option='light'] .theme-switcher__icon--light,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--light {
      transform: rotate(30deg);
    }

    :global(:root[data-theme-preference='dark']) .theme-switcher__btn[data-theme-option='dark'] .theme-switcher__icon--dark,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--dark {
      transform: rotate(-12deg);
    }
  }

  @media (forced-colors: active) {
    .theme-switcher__track {
      border: 1px solid CanvasText;
      background-color: Canvas;
    }

    .theme-switcher__thumb {
      display: none;
    }

    .theme-switcher__btn {
      color: CanvasText;
    }

    .theme-switcher__btn[aria-pressed='true'] {
      background-color: Highlight;
      color: HighlightText;
    }
  }
</style>
