---
import type { Locale } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const t = getTranslations(locale);

const options = [
  {
    value: 'system',
    label: t.theme.system,
    ariaLabel: t.theme.systemAria,
  },
  {
    value: 'light',
    label: t.theme.light,
    ariaLabel: t.theme.lightAria,
  },
  {
    value: 'dark',
    label: t.theme.dark,
    ariaLabel: t.theme.darkAria,
  },
] as const;
---

<div
  class="theme-switcher"
  data-theme-switcher
  role="group"
  aria-label={t.theme.groupLabel}
>
  <span class="theme-switcher__tooltip" data-theme-tooltip aria-hidden="true"></span>
  <div class="theme-switcher__track">
    <span class="theme-switcher__thumb" aria-hidden="true"></span>
    {
      options.map((option) => (
        <button
          type="button"
          class="theme-switcher__btn"
          data-theme-option={option.value}
          data-theme-label={option.label}
          aria-label={option.ariaLabel}
          aria-pressed="false"
        >
          {option.value === 'system' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--system"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.75" />
              <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor" />
            </svg>
          )}
          {option.value === 'light' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--light"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.75" />
              <path
                d="M12 2.75v2.25M12 19v2.25M4.93 4.93l1.6 1.6M17.47 17.47l1.6 1.6M2.75 12H5M19 12h2.25M4.93 19.07l1.6-1.6M17.47 6.53l1.6-1.6"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          )}
          {option.value === 'dark' && (
            <svg
              class="theme-switcher__icon theme-switcher__icon--dark"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M20.25 14.35A8.25 8.25 0 0 1 9.65 3.75a8.25 8.25 0 1 0 10.6 10.6Z"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </button>
      ))
    }
  </div>
</div>

<script>
  for (const switcher of document.querySelectorAll<HTMLElement>('[data-theme-switcher]')) {
    const tooltip = switcher.querySelector<HTMLElement>('[data-theme-tooltip]');
    if (!tooltip) continue;

    const showTooltip = (btn: HTMLElement | null) => {
      const label = btn?.dataset.themeLabel;
      if (!label) return;
      tooltip.textContent = label;
      switcher.dataset.tooltipVisible = 'true';
    };

    const hideTooltip = () => {
      delete switcher.dataset.tooltipVisible;
    };

    switcher.addEventListener('pointerover', (event) => {
      if (event.pointerType === 'touch') return;
      const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-theme-option]') ?? null;
      showTooltip(btn);
    });

    switcher.addEventListener('pointerleave', () => {
      const focused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (focused && switcher.contains(focused) && focused.matches(':focus-visible')) {
        showTooltip(focused.closest<HTMLElement>('[data-theme-option]'));
      } else {
        hideTooltip();
      }
    });

    switcher.addEventListener('focusin', (event) => {
      const btn = (event.target as Element | null)?.closest<HTMLElement>('[data-theme-option]') ?? null;
      if (btn && btn.matches(':focus-visible')) {
        showTooltip(btn);
      }
    });

    switcher.addEventListener('focusout', (event) => {
      const next = event.relatedTarget instanceof HTMLElement ? event.relatedTarget : null;
      if (next && switcher.contains(next)) return;
      hideTooltip();
    });
  }
</script>

<style>
  .theme-switcher {
    --theme-index: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin-inline-start: auto;
    pointer-events: auto;
  }

  :global(:root[data-theme-preference='system']) .theme-switcher {
    --theme-index: 0;
  }

  :global(:root[data-theme-preference='light']) .theme-switcher {
    --theme-index: 1;
  }

  :global(:root[data-theme-preference='dark']) .theme-switcher {
    --theme-index: 2;
  }

  .theme-switcher__tooltip {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: calc(100% + 0.5rem);
    padding-block: 0.22rem;
    padding-inline: 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--fg);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    line-height: 1.25;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    box-shadow: 0 6px 18px rgba(var(--bg-rgb), 0.28);
  }

  .theme-switcher[data-tooltip-visible='true'] .theme-switcher__tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  .theme-switcher__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background-color: color-mix(in srgb, var(--surface) 78%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 18px rgba(var(--bg-rgb), 0.24);
    transition: border-color 220ms var(--ease-editorial), background-color 220ms var(--ease-editorial);
  }

  .theme-switcher:hover .theme-switcher__track,
  .theme-switcher:focus-within .theme-switcher__track {
    border-color: rgba(var(--fg-rgb), 0.26);
  }

  .theme-switcher__thumb {
    position: absolute;
    inset-block: 3px;
    inset-inline-start: 3px;
    inline-size: calc((100% - 6px) / 3);
    border-radius: 999px;
    background-color: var(--fg);
    box-shadow: 0 1px 4px rgba(var(--bg-rgb), 0.3);
    transform: translateX(calc(var(--theme-index, 0) * 100%));
    pointer-events: none;
    will-change: transform;
  }

  .theme-switcher__btn {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 2.15rem;
    block-size: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: transparent;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    transition: color 220ms var(--ease-editorial), background-color 180ms ease;
  }

  .theme-switcher__btn:hover {
    color: var(--fg);
    background-color: rgba(var(--fg-rgb), 0.06);
  }

  :global(:root[data-theme-preference='system']) .theme-switcher__btn[data-theme-option='system'],
  :global(:root[data-theme-preference='light']) .theme-switcher__btn[data-theme-option='light'],
  :global(:root[data-theme-preference='dark']) .theme-switcher__btn[data-theme-option='dark'],
  .theme-switcher__btn[aria-pressed='true'] {
    color: var(--bg);
    background-color: transparent;
  }

  .theme-switcher__btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    z-index: 2;
  }

  .theme-switcher__icon {
    display: block;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theme-switcher__tooltip {
      transition: opacity 180ms var(--ease-editorial), transform 220ms var(--ease-editorial);
    }

    .theme-switcher__thumb {
      transition:
        transform 360ms var(--ease-editorial),
        background-color 220ms var(--ease-editorial);
    }

    .theme-switcher__icon {
      transition: transform 340ms var(--ease-editorial), scale 160ms var(--ease-editorial);
    }

    .theme-switcher__btn:active .theme-switcher__icon {
      scale: 0.88;
    }

    :global(:root[data-theme-preference='system']) .theme-switcher__btn[data-theme-option='system'] .theme-switcher__icon--system,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--system {
      transform: rotate(180deg);
    }

    :global(:root[data-theme-preference='light']) .theme-switcher__btn[data-theme-option='light'] .theme-switcher__icon--light,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--light {
      transform: rotate(30deg);
    }

    :global(:root[data-theme-preference='dark']) .theme-switcher__btn[data-theme-option='dark'] .theme-switcher__icon--dark,
    .theme-switcher__btn[aria-pressed='true'] .theme-switcher__icon--dark {
      transform: rotate(-12deg);
    }
  }

  @media (forced-colors: active) {
    .theme-switcher__track {
      border: 1px solid CanvasText;
      background-color: Canvas;
    }

    .theme-switcher__thumb {
      display: none;
    }

    .theme-switcher__btn {
      color: CanvasText;
    }

    .theme-switcher__btn[aria-pressed='true'] {
      background-color: Highlight;
      color: HighlightText;
    }
  }
</style>
