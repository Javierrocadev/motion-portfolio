---
import type { ProjectItem } from '../../data/projects';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
const cycles = 7;
const first = Math.floor(cycles / 2) * projects.length;
---

<section class="project-stage" aria-label="Proyectos seleccionados">
  <div class="project-stage__viewport" data-project-carousel>
    <div class="project-stage__track" data-project-track data-project-count={projects.length} tabindex="0" role="region" aria-label="Desplazamiento vertical de proyectos">
      {Array.from({ length: cycles }, () => projects).flat().map((project, index) => (
        <div class="project-stage__slide" data-project-slide>
          <article
            class="project-stage__frame"
            data-project-frame
            data-focused={index === first ? true : undefined}
            aria-hidden={index !== first ? "true" : undefined}
            data-project-id={project.id}
            data-project-index={project.index}
            data-left-override={project.leftMediaOverride ? JSON.stringify(project.leftMediaOverride) : undefined}
          >
            <figure class="project-stage__visual">
              <img class="project-stage__image" src={project.image.src} alt={project.image.alt} loading={index === first ? "eager" : "lazy"} decoding="async" />
              <div class="project-stage__vignette" aria-hidden="true"></div>
            </figure>

            {/*
            <header class="project-stage__header">
              <div class="project-stage__meta">
                <span class="project-stage__index">{project.index}</span>
                <span class="project-stage__separator" aria-hidden="true">/</span>
                <span class="project-stage__year">{project.year}</span>
              </div>
              <span class="project-stage__category">{project.category}</span>
            </header>

            <div class="project-stage__content">
              <p class="project-stage__eyebrow">Selected Work</p>
              <h1 class="project-stage__title">{project.title}</h1>
              <p class="project-stage__summary">{project.summary}</p>
            </div>
            */}
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { HERO_EVENTS, type HeroProjectChangeDetail } from '../../scripts/heroBridge';

  const LIST_HEIGHT = 300;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const stage of document.querySelectorAll<HTMLElement>('[data-project-carousel]')) {
    const track = stage.querySelector<HTMLElement>('[data-project-track]')!;
    track.style.setProperty('--project-list-height', LIST_HEIGHT + 'px');
    const slides = [...track.querySelectorAll<HTMLElement>('[data-project-slide]')];
    const count = Number(track.dataset.projectCount);
    const middle = Math.floor(slides.length / count / 2) * count;
    if (!count) continue;

    const card = (index: number) => slides[index].firstElementChild as HTMLElement;
    const center = (index: number) => slides[index].offsetTop + (slides[index].offsetHeight - track.clientHeight) / 2;
    const root = stage.closest<HTMLElement>('[data-hero-root]');
    let candidate = middle;
    let focused: HTMLElement | undefined = card(middle);
    let idle = 0;
    let parkTimer = 0;
    let raf = 0;
    let touching = false;
    let wheelFrame = 0;
    let wheel: { position: number; intent: number; target: number; velocity: number; time: number; direction: number } | undefined;
    let aligning = false;
    let release: { project: HTMLElement; origin: number; scale: number; width: number; height: number } | undefined;
    let lastUserScroll = 0;
    let scrollCorrection: number | undefined;

    function notify(project: HTMLElement) {
      const { projectId = '', projectIndex = '', leftOverride } = project.dataset;
      if (!root) return;
      root.dataset.activeProject = projectId;
      root.dispatchEvent(new CustomEvent<HeroProjectChangeDetail>(HERO_EVENTS.PROJECT_CHANGE, {
        detail: { projectId, index: projectIndex, leftMediaOverride: leftOverride ? JSON.parse(leftOverride) : undefined },
      }));
    }

    function highlight() {
      const position = track.scrollTop;
      let nearest = candidate;
      for (let index = 0; index < slides.length; index++) {
        if (Math.abs(center(index) - position) < Math.abs(center(nearest) - position)) nearest = index;
      }
      card(candidate).removeAttribute('data-candidate');
      card(candidate).setAttribute('aria-hidden', 'true');
      candidate = nearest;
      card(candidate).setAttribute('data-candidate', '');
      card(candidate).removeAttribute('aria-hidden');
      if (reducedMotion.matches) {
        clearRelease();
        return;
      }

      const centers = slides.map((_, index) => center(index));
      const step = Math.max(1, centers[1] - centers[0]);
      const baseWidth = Math.min(track.clientWidth, 500);
      const baseHeight = Math.min(track.clientHeight, LIST_HEIGHT / 0.4);
      const scales = centers.map((point) => {
        const proximity = Math.max(0, 1 - Math.abs(point - position) / step);
        return 0.4 + 0.8 * proximity * proximity * (3 - 2 * proximity);
      });
      const outgoing = releaseGeometry(position, step, scales, baseWidth, baseHeight);
      let accumulated = 0;
      const offsets = scales.map((scale, index) => {
        const visibleHeight = outgoing?.index === index ? outgoing.height * outgoing.scale : baseHeight * scale;
        const extra = visibleHeight - 0.4 * baseHeight;
        const offset = accumulated + extra / 2;
        accumulated += extra;
        return offset;
      });
      const left = Math.min(slides.length - 2, Math.max(0, Math.floor((position - centers[0]) / step)));
      const fraction = Math.min(1, Math.max(0, (position - centers[left]) / step));
      const anchor = offsets[left] + (offsets[left + 1] - offsets[left]) * fraction;
      for (let index = 0; index < slides.length; index++) {
        const frame = card(index);
        frame.style.setProperty('--browse-scale', String(scales[index]));
        frame.style.setProperty('--browse-width', baseWidth + 'px');
        frame.style.setProperty('--browse-offset', (offsets[index] - anchor) + 'px');
      }
      if (outgoing) {
        const { project, index, scale, width, height } = outgoing;
        project.style.transform = `translate(-50%, calc(-50% + ${offsets[index] - anchor}px)) scale(${scale})`;
        project.style.width = width + 'px';
        project.style.height = height + 'px';
      }
    }

    function rebase() {
      const equivalent = middle + candidate % count;
      if (equivalent === candidate) return;

      const previousPosition = track.scrollTop;
      track.setAttribute('data-rebasing', '');
      const position = previousPosition + center(equivalent) - center(candidate);
      const windowSize = Math.min(2, Math.floor((Math.abs(equivalent - candidate) - 1) / 2));

      // Carry the whole visible neighborhood, not just the highlighted image.
      for (let offset = -windowSize; offset <= windowSize; offset++) {
        const source = slides[candidate + offset];
        const target = slides[equivalent + offset];
        if (!source || !target) continue;

        const current = source.firstElementChild!;
        const replacement = target.firstElementChild!;
        if (typeof source.moveBefore === 'function') {
          source.moveBefore(replacement, null);
          target.moveBefore(current, null);
        } else {
          source.append(replacement);
          target.append(current);
        }
      }

      candidate = equivalent;
      track.scrollTop = position;
      scrollCorrection = track.scrollTop;
      if (wheel) {
        const shift = scrollCorrection - previousPosition;
        wheel.position += shift;
        wheel.intent += shift;
        wheel.target += shift;
      }
      if (release) release.origin += scrollCorrection - previousPosition;
      requestAnimationFrame(() => requestAnimationFrame(() => track.removeAttribute('data-rebasing')));
      highlight();
    }

    function park() {
      if (focused) return;
      highlight();
      if (candidate < middle - count || candidate >= middle + 2 * count) rebase();
    }

    function clearRelease() {
      if (!release) return;
      const { project } = release;
      project.style.removeProperty('transform');
      project.style.removeProperty('width');
      project.style.removeProperty('height');
      project.removeAttribute('data-leaving-focus');
      release = undefined;
    }

    function releaseFocus(project: HTMLElement) {
      if (!reducedMotion.matches) {
        const current = getComputedStyle(project);
        release = {
          project,
          origin: center(candidate),
          scale: new DOMMatrix(current.transform).a,
          width: parseFloat(current.width),
          height: parseFloat(current.height),
        };
        project.setAttribute('data-leaving-focus', '');
      }
      project.removeAttribute('data-focused');
    }

    function releaseGeometry(position: number, step: number, scales: number[], width: number, height: number) {
      if (!release) return;
      const { project, origin, scale, width: initialWidth, height: initialHeight } = release;
      const index = slides.indexOf(project.parentElement as HTMLElement);
      const progress = Math.min(1, Math.abs(position - origin) / step);
      if (progress >= 1 || index < 0) {
        clearRelease();
        return;
      }

      // Use the outgoing card's rendered height to reserve space for its neighbors.
      const blend = 1 - (1 - progress) ** 2;
      return {
        project,
        index,
        scale: scale + (scales[index] - scale) * blend,
        width: initialWidth + (width - initialWidth) * blend,
        height: initialHeight + (height - initialHeight) * blend,
      };
    }
    function settle() {
      if (focused || touching || wheel) return;
      clearTimeout(parkTimer);
      cancelAnimationFrame(raf);
      park();
      const target = center(candidate);
      if (Math.abs(track.scrollTop - target) >= 2 && !aligning) {
        aligning = true;
        track.scrollTo({ top: target, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
        parkTimer = window.setTimeout(settle, 400);
        return;
      }
      aligning = false;
      track.removeAttribute('data-free-wheel');
      clearTimeout(idle);
      idle = window.setTimeout(focusCandidate, Math.max(0, 1000 - (performance.now() - lastUserScroll)));
    }
    function focusCandidate() {
      clearRelease();
      focused = card(candidate);
      focused.setAttribute('data-focused', '');
      focused.removeAttribute('data-candidate');
      if (root?.dataset.activeProject !== focused.dataset.projectId) notify(focused);
    }

    track.scrollTop = center(candidate);
    notify(focused);
    new ResizeObserver(() => {
      if (focused) track.scrollTop = center(candidate);
    }).observe(track);

    function cancelPendingFocus() {
      clearTimeout(idle);
      if (!aligning) return;
      aligning = false;
      clearTimeout(parkTimer);
      track.scrollTo({ top: track.scrollTop, behavior: 'instant' });
    }

    function stopWheel() {
      cancelAnimationFrame(wheelFrame);
      wheel = undefined;
      track.removeAttribute('data-free-wheel');
    }

    function advanceWheel(now: number) {
      if (!wheel) return;
      // Exact critically damped step: retarget without resetting position or velocity.
      const dt = Math.max(0, Math.min(48, now - wheel.time));
      wheel.time = now;
      const rate = 1 / 76;
      // Blend into the landing from the first frame, not after an inactivity timeout.
      const age = Math.max(0, now - lastUserScroll);
      const attraction = 1 - Math.exp(-((age / 100) ** 2));
      const aim = wheel.intent + (wheel.target - wheel.intent) * attraction;
      const offset = wheel.position - aim;
      const carry = wheel.velocity + rate * offset;
      const decay = Math.exp(-rate * dt);
      wheel.position = aim + (offset + carry * dt) * decay;
      wheel.velocity = (wheel.velocity - rate * carry * dt) * decay;
      const arrived = Math.abs(aim - wheel.target) < 0.5 && Math.abs(wheel.position - wheel.target) < 0.5 && Math.abs(wheel.velocity) < 0.02;
      track.scrollTop = arrived ? wheel.target : wheel.position;
      if (!arrived) {
        wheelFrame = requestAnimationFrame(advanceWheel);
        return;
      }
      scrollCorrection = track.scrollTop;
      stopWheel();
      settle();
    }

    track.addEventListener('wheel', (event) => {
      if (event.ctrlKey || !event.deltaY || Math.abs(event.deltaX) > Math.abs(event.deltaY)
        || reducedMotion.matches || !event.cancelable) return;
      event.preventDefault();
      cancelPendingFocus();
      clearTimeout(parkTimer);
      const now = performance.now();
      const step = center(1) - center(0);
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? track.clientHeight : 1;
      const delta = Math.sign(event.deltaY) * Math.min(Math.abs(event.deltaY * unit), step * count);
      const direction = Math.sign(delta);
      if (!wheel) {
        track.setAttribute('data-free-wheel', '');
        const position = track.scrollTop;
        wheel = { position, intent: position, target: position, velocity: 0, time: now, direction };
        wheelFrame = requestAnimationFrame(advanceWheel);
      }
      if (direction !== wheel.direction) wheel.intent = wheel.target = wheel.position;
      wheel.direction = direction;
      // Accumulate input independently of the displayed position, including tiny trackpad deltas.
      wheel.intent += delta;
      // The midpoint between centers is the escape threshold in either direction.
      const index = Math.round((wheel.intent - center(0)) / step);
      wheel.target = center(Math.max(0, Math.min(slides.length - 1, index)));
      lastUserScroll = now;
    }, { passive: false });
    for (const event of ['pointerdown', 'touchstart', 'keydown']) {
      track.addEventListener(event, () => { if (wheel) stopWheel(); cancelPendingFocus(); }, { passive: true });
    }
    track.addEventListener('touchstart', () => { touching = true; }, { passive: true });
    for (const event of ['touchend', 'touchcancel']) {
      track.addEventListener(event, (input) => {
        touching = (input as TouchEvent).touches.length > 0;
        if (!touching && !('onscrollend' in track)) {
          clearTimeout(parkTimer);
          parkTimer = window.setTimeout(settle, 160);
        }
      }, { passive: true });
    }

    track.addEventListener('scroll', () => {
      if (scrollCorrection !== undefined) {
        const corrected = Math.abs(track.scrollTop - scrollCorrection) < 2;
        scrollCorrection = undefined;
        if (corrected) return;
      }
      if (focused && Math.abs(track.scrollTop - center(candidate)) < 2) return;
      if (focused) releaseFocus(focused);
      focused = undefined;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        highlight();
        // Refill the runway before a sustained gesture reaches either physical end.
        if (candidate <= count || candidate >= slides.length - count - 1) rebase();
      });
      clearTimeout(idle);
      if (!aligning && !wheel) {
        clearTimeout(parkTimer);
        lastUserScroll = performance.now();
        if (!('onscrollend' in track)) {
          parkTimer = window.setTimeout(settle, 160);
        }
      }
    }, { passive: true });

    track.addEventListener('scrollend', settle);
  }
</script>
<style>
  .project-stage {
    position: relative;
    width: 100%;
    height: 100%;
    padding: clamp(1.25rem, 2.8vw, 2.5rem);
    background-color: var(--bg);
    display: flex;
  }

  .project-stage__frame {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 0;
    overflow: hidden;
    background-color: var(--surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    isolation: isolate;
  }

  .project-stage__visual {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .project-stage__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-stage__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(9, 9, 11, 0.56) 0%,
        rgba(9, 9, 11, 0.14) 45%,
        rgba(9, 9, 11, 0.84) 100%
      ),
      radial-gradient(circle at 80% 20%, rgba(9, 9, 11, 0.08), rgba(9, 9, 11, 0.45));
    pointer-events: none;
  }

  .project-stage__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-stage__meta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--fg);
  }

  .project-stage__separator,
  .project-stage__year {
    color: var(--muted);
  }

  .project-stage__category {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
    padding: 0.38rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgba(244, 244, 245, 0.18);
    background-color: rgba(9, 9, 11, 0.42);
    backdrop-filter: blur(8px);
  }

  .project-stage__content {
    max-width: 38rem;
    display: grid;
    gap: 0.75rem;
  }

  .project-stage__eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .project-stage__title {
    font-size: clamp(2.1rem, 4.1vw, 3.85rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .project-stage__summary {
    font-size: clamp(0.95rem, 1.15vw, 1.1rem);
    line-height: 1.55;
    color: rgba(244, 244, 245, 0.8);
    max-width: 34rem;
  }

  .project-stage__viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    isolation: isolate;
    container-type: size;
  }

  .project-stage__track {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    scrollbar-width: none;
    overscroll-behavior-y: contain;
    scroll-snap-type: y mandatory;
    overflow-anchor: none;
    padding-block: 27.5cqh;
  }

  .project-stage__track:is([data-rebasing], [data-free-wheel]) { scroll-snap-type: none; }

  .project-stage__viewport:has(.project-stage__track:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .project-stage__slide {
    position: relative;
    height: 45cqh;
    scroll-snap-align: center;
  }

  [data-project-frame] {
    position: absolute;
    top: 50%;
    left: 50%;
    --project-list-width: 200px;
    /* Match the real box to its 40% list scale instead of animating a mask. */
    width: min(100cqw, calc(var(--project-list-width) / 0.4));
    height: min(100cqh, calc(var(--project-list-height, 300px) / 0.4));
    transform: translate(-50%, -50%) scale(0.4);
    pointer-events: none;
  }

  [data-project-frame] :is(.project-stage__header, .project-stage__content) {
    visibility: hidden;
  }

  .project-stage__track:has([data-focused]) [data-project-frame]:not([data-focused]) {
    visibility: hidden;
  }

  [data-candidate] { z-index: 1; }
  [data-focused] {
    width: 100cqw;
    height: 100cqh;
    z-index: 2;
    transform: translate(-50%, -50%);
  }

  [data-focused] :is(.project-stage__header, .project-stage__content) {
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-stage__track {
      --project-focus-duration: 300ms;
      /* Half the viewport plus half a list card, minus the slot spacing. */
      --project-exit-offset: calc(50cqh + min(20cqh, var(--project-list-height, 300px) / 2) - 45cqh + 1px);
    }
    [data-project-frame] {
      width: var(--browse-width, min(100cqw, 500px));
      transform: translate(-50%, calc(-50% + var(--browse-offset, 0px))) scale(var(--browse-scale, 0.4));
    }
    [data-focused] {
      width: 100cqw;
      transform: translate(-50%, -50%);
      transition: transform var(--project-focus-duration) ease-in-out,
        width var(--project-focus-duration) ease-in-out,
        height var(--project-focus-duration) ease-in-out;
    }
    [data-leaving-focus] {
      z-index: 2;
      transition: none;
    }

    .project-stage__track:has([data-focused]) [data-project-frame]:not([data-focused]) {
      transition: transform var(--project-focus-duration) ease-in-out,
        width var(--project-focus-duration) ease-in-out,
        height var(--project-focus-duration) ease-in-out,
        visibility 0s linear var(--project-focus-duration);
    }
    .project-stage__slide:has(+ .project-stage__slide > [data-focused]) > [data-project-frame] {
      transform: translate(-50%, calc(-50% - var(--project-exit-offset))) scale(0.4);
    }

    .project-stage__slide:has(> [data-focused]) + .project-stage__slide > [data-project-frame] {
      transform: translate(-50%, calc(-50% + var(--project-exit-offset))) scale(0.4);
    }
  }
</style>
