---
import type { ProjectItem } from '../../data/projects';
import { parseCategories, serializeProjectDetails } from '../../scripts/projectDetails';

interface Props {
  projects: ProjectItem[];
  projectsPath: string;
  stageAriaLabel?: string;
  trackAriaLabel?: string;
  badgeLabel?: string;
  exitLabel?: string;
  prevLabel?: string;
  nextLabel?: string;
  returnLabel?: string;
}

const {
  projects,
  projectsPath,
  stageAriaLabel = 'Proyectos seleccionados',
  trackAriaLabel = 'Desplazamiento vertical de proyectos',
  badgeLabel = 'Ver',
  exitLabel = 'Sigue bajando para salir',
  prevLabel = 'Proyecto anterior',
  nextLabel = 'Siguiente proyecto',
  returnLabel = 'Volver',
} = Astro.props;
const tone = (value: string | null | undefined, fallback: string) =>
  value && /^#[0-9a-f]{6}$/i.test(value) ? value : fallback;
const posterFor = (project: ProjectItem) => project.image?.src ??
  (project.video?.endsWith('/8d90945dc01903446d2fb84dc7601e6b194785e3.mp4')
    ? '/posters/website-promo.webp' : undefined);
const cycles = 7;
const first = Math.floor(cycles / 2) * projects.length;
const initialCategories = parseCategories(projects[0]?.category ?? '');
const noiseId = `project-stage-noise-${crypto.randomUUID()}`;
const mediaTintId = `${noiseId}-media-tint`;

const CYLINDER_REPEATS = 5;
const CYLINDER_STEP = 360 / CYLINDER_REPEATS;
const CYLINDER_UNIT_ANGLE = 10.5;
const glyphWeight = (char: string) =>
  /[IJL1|!.,:'`]/.test(char) ? 0.55 : /[MW@]/.test(char) ? 1.3 : 1;

const cylinderGlyphsFor = (label: string) => {
  const labelChars = Array.from(label.trim().toLocaleUpperCase());
  const glyphWeights = labelChars.map(glyphWeight);
  const wordWeight = glyphWeights.reduce((sum, weight) => sum + weight, 0);
  const maxWordSpan = CYLINDER_STEP * 0.62;
  const unitAngle = wordWeight > 0
    ? Math.min(CYLINDER_UNIT_ANGLE, maxWordSpan / wordWeight)
    : CYLINDER_UNIT_ANGLE;

  const wordOffsets: Array<{ char: string; offset: number }> = [];
  let glyphCursor = -wordWeight / 2;
  for (let i = 0; i < labelChars.length; i++) {
    const weight = glyphWeights[i];
    wordOffsets.push({
      char: labelChars[i],
      offset: Number(((glyphCursor + weight / 2) * unitAngle).toFixed(2)),
    });
    glyphCursor += weight;
  }

  const cylinderGlyphs = Array.from({ length: CYLINDER_REPEATS }, (_, repeat) => {
    const baseAngle = repeat * CYLINDER_STEP;
    return [
      ...wordOffsets.map(({ char, offset }) => ({
        char,
        angle: Number((baseAngle + offset).toFixed(2)),
        isSep: false,
      })),
      {
        char: '•',
        angle: Number((baseAngle + CYLINDER_STEP / 2).toFixed(2)),
        isSep: true,
      },
    ];
  }).flat();
  return cylinderGlyphs;
};
const badgeFaces = [
  { glyphs: cylinderGlyphsFor(badgeLabel), returning: false },
  { glyphs: cylinderGlyphsFor(returnLabel), returning: true },
];

const CYLINDER_VIEW_W = 100;
const CYLINDER_VIEW_H = 68;
const CYLINDER_RADIUS = 38;
const CYLINDER_HALF_H = 12;
const CYLINDER_PERSPECTIVE = 480;
const CYLINDER_TILT_DEG = 24;

const tiltRad = (CYLINDER_TILT_DEG * Math.PI) / 180;
const cosTilt = Math.cos(tiltRad);
const sinTilt = Math.sin(tiltRad);

const projectCylinder = (angleDeg: number, y: number) => {
  const rad = (angleDeg * Math.PI) / 180;
  const x = CYLINDER_RADIUS * Math.sin(rad);
  const z = CYLINDER_RADIUS * Math.cos(rad);
  const y1 = y * cosTilt + z * sinTilt;
  const z1 = -y * sinTilt + z * cosTilt;
  const scale = CYLINDER_PERSPECTIVE / (CYLINDER_PERSPECTIVE - z1);
  return {
    x: Number((CYLINDER_VIEW_W / 2 + x * scale).toFixed(2)),
    y: Number((CYLINDER_VIEW_H / 2 + y1 * scale).toFixed(2)),
  };
};

const horizonAngle = (y: number) =>
  (Math.acos((CYLINDER_RADIUS * cosTilt) / (CYLINDER_PERSPECTIVE + y * sinTilt)) * 180) / Math.PI;

const arcPath = (startDeg: number, endDeg: number, y: number, segments = 32) =>
  Array.from({ length: segments + 1 }, (_, i) => {
    const angle = startDeg + ((endDeg - startDeg) * i) / segments;
    const { x, y: py } = projectCylinder(angle, y);
    return `${i === 0 ? 'M' : 'L'}${x} ${py}`;
  }).join(' ');

const topHorizon = horizonAngle(-CYLINDER_HALF_H);
const bottomHorizon = horizonAngle(CYLINDER_HALF_H);
const leftTop = projectCylinder(-topHorizon, -CYLINDER_HALF_H);
const leftBottom = projectCylinder(-bottomHorizon, CYLINDER_HALF_H);
const rightTop = projectCylinder(topHorizon, -CYLINDER_HALF_H);
const rightBottom = projectCylinder(bottomHorizon, CYLINDER_HALF_H);

const cylinderContour = {
  frontTop: arcPath(-topHorizon, topHorizon, -CYLINDER_HALF_H),
  backTop: arcPath(topHorizon, 360 - topHorizon, -CYLINDER_HALF_H),
  frontBottom: arcPath(-bottomHorizon, bottomHorizon, CYLINDER_HALF_H),
  backBottom: arcPath(bottomHorizon, 360 - bottomHorizon, CYLINDER_HALF_H),
  leftEdge: `M${leftTop.x} ${leftTop.y} L${leftBottom.x} ${leftBottom.y}`,
  rightEdge: `M${rightTop.x} ${rightTop.y} L${rightBottom.x} ${rightBottom.y}`,
};
---

<section class="project-stage" aria-label={stageAriaLabel}>
  <div class="project-stage__viewport" data-project-carousel>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id={mediaTintId} color-interpolation-filters="sRGB">
          <!-- Equivalent to a 30% charcoal veil, without painting transparent contain margins. -->
          <feColorMatrix type="matrix" values="0.7 0 0 0 0.0282353  0 0.7 0 0 0.0282353  0 0 0.7 0 0.0317647  0 0 0 1 0" />
        </filter>
        <filter id={noiseId}>
          <feTurbulence type="turbulence" baseFrequency="0.9" numOctaves="2" seed="1" stitchTiles="stitch" result="turbulence" />
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="30" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <div class="project-stage__background" data-project-background aria-hidden="true">
      <div class="project-stage__backdrop" style={{
        '--preview-soft': tone(projects[0]?.image?.softTone, '#47464a'),
        '--preview-dark': tone(projects[0]?.image?.darkTone, '#202024'),
        filter: `url("#${noiseId}")`,
      }}></div>
    </div>
    <div class="project-stage__track" data-project-track data-project-count={projects.length} tabindex="0" role="region" aria-label={trackAriaLabel}>
      {Array.from({ length: cycles }, () => projects).flat().map((project, index) => (
        <div class="project-stage__slide" data-project-slide>
          <a
            href={projectsPath + '/#project-' + encodeURIComponent(project.id)}
            aria-label={project.title}
            tabindex={index === first ? 0 : -1}
            class="project-stage__frame"
            data-soft-tone={tone(project.image?.softTone, '#47464a')}
            data-dark-tone={tone(project.image?.darkTone, '#202024')}
            data-video-src={project.video ?? undefined}
            data-project-frame
            data-focused={index === first ? true : undefined}
            data-focus-ready={index === first ? true : undefined}
            aria-hidden={index !== first ? "true" : undefined}
            data-project-id={project.id}
            data-project-index={project.index}
            data-project-category={project.category || undefined}
            data-project-details={serializeProjectDetails(project)}
            aria-controls="project-details"
            aria-expanded="false"
            data-left-override={project.leftMediaOverride ? JSON.stringify(project.leftMediaOverride) : undefined}
          >
            <figure class="project-stage__visual" style={{ filter: `url("#${mediaTintId}")` }}>
              <!-- Render each project using the media published in the shared Studio. -->
              {posterFor(project) ? (
                <img class="project-stage__image" src={posterFor(project)} alt={project.image?.alt || project.title} loading={index === first ? "eager" : "lazy"} decoding="async" />
              ) : <figcaption>{project.title}</figcaption>}

            </figure>

            {/*
            <header class="project-stage__header">
              <div class="project-stage__meta">
                <span class="project-stage__index">{project.index}</span>
                <span class="project-stage__separator" aria-hidden="true">/</span>
                <span class="project-stage__year">{project.year}</span>
              </div>
              <span class="project-stage__category">{project.category}</span>
            </header>

            <div class="project-stage__content">
              <p class="project-stage__eyebrow">Selected Work</p>
              <h1 class="project-stage__title">{project.title}</h1>
              <p class="project-stage__summary">{project.summary}</p>
            </div>
            */}
          </a>
          <p class="project-stage__name" data-project-name aria-hidden="true">{project.title}</p>
        </div>
      ))}
    </div>
    <div class="stage-rail" data-stage-rail aria-hidden="true">
      {projects.map((_, i) => (
        <span
          class="stage-rail__tick"
          data-rail-index={i}
          data-active={i === 0 ? '' : undefined}
          data-near={projects.length > 1 && (i === 1 || i === projects.length - 1) ? '' : undefined}
        ></span>
      ))}
    </div>
    <div class="stage-hud" data-stage-hud>
      <div class="stage-hud__meta" aria-live="polite" aria-atomic="true">
        <span class="stage-hud__counter">
          <span class="stage-hud__current" data-stage-current>{projects[0]?.index ?? '01'}</span>
          <span class="stage-hud__slash" aria-hidden="true">/</span>
          <span class="stage-hud__total">{String(projects.length).padStart(2, '0')}</span>
        </span>
        <span class="stage-hud__category" data-stage-category hidden={!initialCategories.length}>
          {initialCategories.map((tag, i) => (
            <>
              {i > 0 && <>{' '}<span class="stage-hud__tag-sep" aria-hidden="true">·</span>{' '}</>}
              <span class="stage-hud__tag">{tag}</span>
            </>
          ))}
        </span>
      </div>
      <div class="stage-hud__controls">
        <button type="button" class="stage-hud__btn" data-stage-prev aria-label={prevLabel}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 10.5v-7M3.75 6.5 7 3.25 10.25 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="stage-hud__btn" data-stage-next aria-label={nextLabel}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 3.5v7M3.75 7.5 7 10.75 10.25 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
    <button type="button" class="stage-badge" data-stage-badge data-return-label={returnLabel} aria-label={badgeLabel} aria-hidden="true" tabindex="-1">
      <div class="stage-badge__rig">
        <svg class="stage-badge__contour stage-badge__contour--back" viewBox="0 0 100 68" aria-hidden="true">
          <path class="stage-badge__rim stage-badge__rim--back" d={cylinderContour.backTop} />
          <path class="stage-badge__rim stage-badge__rim--back-bottom" d={cylinderContour.backBottom} />
        </svg>
        {badgeFaces.map(({ glyphs, returning }) => (
          <div class="stage-badge__scene" class:list={[returning && 'stage-badge__scene--return']}>
            <div class="stage-badge__tilt">
              <div class="stage-badge__drum">
                {glyphs.map((glyph) => (
                  <span
                    class:list={['stage-badge__glyph', 'stage-badge__glyph--front', glyph.isSep && 'stage-badge__glyph--sep']}
                    style={`--glyph-angle: ${glyph.angle}deg`}
                  >
                    {glyph.char}
                  </span>
                ))}
              {glyphs.map((glyph) => (
                <span
                  class:list={['stage-badge__glyph', 'stage-badge__glyph--back', glyph.isSep && 'stage-badge__glyph--sep']}
                  style={`--glyph-angle: ${glyph.angle}deg`}
                >
                  <span class="stage-badge__glyph-inner">{glyph.char}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
        ))}
        <svg class="stage-badge__contour stage-badge__contour--front" viewBox="0 0 100 68" aria-hidden="true">
          <path class="stage-badge__rim stage-badge__rim--front" d={cylinderContour.frontTop} />
          <path class="stage-badge__rim stage-badge__rim--front" d={cylinderContour.frontBottom} />
          <path class="stage-badge__edge" d={cylinderContour.leftEdge} />
          <path class="stage-badge__edge" d={cylinderContour.rightEdge} />
        </svg>
      </div>
    </button>
    <span class="stage-cursor" data-stage-cursor aria-hidden="true"></span>
    <button
      class="stage-exit"
      type="button"
      data-stage-exit
      aria-label={exitLabel}
      aria-hidden="true"
      tabindex="-1"
    >
      <span class="stage-exit__fill" aria-hidden="true"></span>
      <span class="stage-exit__label">
        <svg class="stage-exit__arrow" width="18" height="18" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M6 2.25v7.5M2.75 6.5 6 9.75 9.25 6.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </button>
  </div>
</section>

<script>
  import { HERO_EVENTS, type HeroProjectChangeDetail } from '../../scripts/heroBridge';
  import { initProjectDetails, parseCategories } from '../../scripts/projectDetails';

  const PREVIEW_WIDTH = 800;
  const PREVIEW_RATIO = 16 / 9;
  const NAME_GAP = 16;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const coarseHover = matchMedia('(hover: none)');

  for (const stage of document.querySelectorAll<HTMLElement>('[data-project-carousel]')) {
    const backdrop = stage.querySelector<HTMLElement>('.project-stage__backdrop')!;
    const track = stage.querySelector<HTMLElement>('[data-project-track]')!;
    const badge = stage.querySelector<HTMLButtonElement>('[data-stage-badge]');
    const cursor = stage.querySelector<HTMLElement>('[data-stage-cursor]');
    const exitButton = stage.querySelector<HTMLButtonElement>('[data-stage-exit]');
    const hud = stage.querySelector<HTMLElement>('[data-stage-hud]');
    const hudCurrent = stage.querySelector<HTMLElement>('[data-stage-current]');
    const hudCategory = stage.querySelector<HTMLElement>('[data-stage-category]');
    const prevBtn = stage.querySelector<HTMLButtonElement>('[data-stage-prev]');
    const nextBtn = stage.querySelector<HTMLButtonElement>('[data-stage-next]');
    const railTicks = [...stage.querySelectorAll<HTMLElement>('[data-rail-index]')];
    track.style.setProperty('--preview-max-width', PREVIEW_WIDTH + 'px');
    const slides = [...track.querySelectorAll<HTMLElement>('[data-project-slide]')];
    const names = slides.map(slide => slide.querySelector<HTMLElement>('[data-project-name]')!);
    const count = Number(track.dataset.projectCount);
    const middle = Math.floor(slides.length / count / 2) * count;
    if (!count) continue;

    const card = (index: number) => slides[index].firstElementChild as HTMLElement;
    let centers: number[] = [];
    let nameCenters: number[] = [];
    let step = 1, baseWidth = 1, baseHeight = 1, peakScale = 1;
    function measure() {
      const width = track.clientWidth, height = track.clientHeight;
      centers = slides.map(slide => slide.offsetTop + (slide.offsetHeight - height) / 2);
      step = Math.max(1, (centers.at(-1)! - centers[0]) / (slides.length - 1));
      baseWidth = Math.min(PREVIEW_WIDTH, width / 1.2, height * PREVIEW_RATIO / 1.2);
      baseHeight = baseWidth / PREVIEW_RATIO;
      peakScale = Math.min(1.2, 0.8 * width / baseWidth, 0.8 * height / baseHeight);
      let nameTop = 0;
      nameCenters = names.map(name => {
        const height = name.offsetHeight;
        const center = nameTop + height / 2;
        nameTop += height + NAME_GAP;
        return center;
      });
    }
    function renderNames() {
      const position = track.scrollTop;
      const left = Math.max(0, Math.min(slides.length - 2, Math.floor((position - centers[0]) / step)));
      const fraction = Math.max(0, Math.min(1, (position - centers[left]) / step));
      const anchor = reducedMotion.matches ? nameCenters[candidate]
        : nameCenters[left] + (nameCenters[left + 1] - nameCenters[left]) * fraction;
      for (let index = Math.max(0, candidate - 1); index <= Math.min(names.length - 1, candidate + 1); index++) {
        // Cancel the image slot spacing and replace it with measured text height + 16px.
        const correction = position - centers[index] + nameCenters[index] - anchor;
        names[index].style.transform = `translateY(calc(-50% + ${correction}px))`;
      }
    }
    measure();
    const center = (index: number) => centers[index];
    const root = stage.closest<HTMLElement>('[data-hero-root]');
    const details = root ? initProjectDetails(root, track) : undefined;
    let candidate = middle;
    let focused: HTMLElement | undefined = card(middle);
    let focusReadyGeneration = 0;
    let focusReadyTimer = 0;
    let idle = 0;
    let parkTimer = 0;
    let touching = false;
    let wheelFrame = 0;
    let wheel: { position: number; intent: number; target: number; velocity: number; time: number; direction: number } | undefined;
    let aligning = false;
    let release: { project: HTMLElement; origin: number; scale: number; width: number; height: number } | undefined;
    let lastUserScroll = 0;
    let scrollCorrection: number | undefined;

    let preview: HTMLVideoElement | undefined;
    let stageVisible = false;
    let generation = 0;
    const leaving = new Set<HTMLVideoElement>();

    let pointerActive = false;
    let pointerX = 0;
    let pointerY = 0;
    let badgeX = 0;
    let badgeY = 0;
    let badgeTargetX = 0;
    let badgeTargetY = 0;
    let badgeVisible = false;
    let badgeRaf = 0;
    let badgeTime = 0;

    function focusedMediaRect(frame: HTMLElement) {
      const rect = frame.getBoundingClientRect();
      const video = frame.querySelector<HTMLVideoElement>('.focus-video[data-visible]');
      const img = frame.querySelector<HTMLImageElement>('.project-stage__image');
      const ratio =
        video && video.videoWidth && video.videoHeight
          ? video.videoWidth / video.videoHeight
          : img && img.naturalWidth && img.naturalHeight
            ? img.naturalWidth / img.naturalHeight
            : PREVIEW_RATIO;
      let width = rect.width;
      let height = rect.height;
      if (width / height > ratio) width = height * ratio;
      else height = width / ratio;
      const left = rect.left + (rect.width - width) / 2;
      const top = rect.top + (rect.height - height) / 2;
      return { left, top, right: left + width, bottom: top + height, width, height };
    }

    function hideBadge() {
      cancelAnimationFrame(badgeRaf);
      badgeRaf = 0;
      badgeVisible = false;
      stage.removeAttribute('data-badge-tracking');
      if (cursor) {
        cursor.removeAttribute('data-visible');
        cursor.removeAttribute('data-docked');
      }
      if (!badge) return;
      badge.removeAttribute('data-visible');
      badge.removeAttribute('data-return');
      badge.setAttribute('aria-hidden', 'true');
      badge.tabIndex = -1;
      badge.removeAttribute('data-pressed');
      badge.removeAttribute('data-docked');
    }

    function stepBadge(now: number) {
      badgeRaf = 0;
      if (!badge || !badgeVisible || badge.hasAttribute('data-docked')) return;
      const dt = Math.max(4, Math.min(48, now - badgeTime));
      badgeTime = now;
      const ease = 1 - Math.exp(-dt / 42);
      const dx = badgeTargetX - badgeX;
      const dy = badgeTargetY - badgeY;
      badgeX += dx * ease;
      badgeY += dy * ease;
      badge.style.translate = `${badgeX.toFixed(1)}px ${badgeY.toFixed(1)}px`;
      if (Math.hypot(dx, dy) > 0.25) {
        badgeRaf = requestAnimationFrame(stepBadge);
      } else {
        badgeX = badgeTargetX;
        badgeY = badgeTargetY;
        badge.style.translate = `${badgeX.toFixed(1)}px ${badgeY.toFixed(1)}px`;
      }
    }

    function dockBadge(frame: HTMLElement) {
      if (!badge) return;
      cancelAnimationFrame(badgeRaf);
      badgeRaf = 0;
      badge.setAttribute('data-docked', '');
      const sr = stage.getBoundingClientRect();
      const media = focusedMediaRect(frame);
      const margin = coarseHover.matches ? 14 : 18;
      const insetX = Math.max(36, badge.offsetWidth / 2 + margin);
      const insetY = Math.max(22, badge.offsetHeight / 2 + margin);
      const x = Math.max(insetX, media.right - sr.left - insetX);
      const y = Math.max(insetY, media.bottom - sr.top - insetY);
      badgeX = badgeTargetX = x;
      badgeY = badgeTargetY = y;
      badge.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
      badge.setAttribute('data-visible', '');
      if (cursor) {
        cursor.style.translate = `${x.toFixed(1)}px ${y.toFixed(1)}px`;
        cursor.setAttribute('data-docked', '');
        cursor.setAttribute('data-visible', '');
      }
      stage.removeAttribute('data-badge-tracking');
      badgeVisible = true;
    }

    function showReturnBadge(frame: HTMLElement) {
      if (!badge) return;
      badge.removeAttribute('data-docked');
      badge.removeAttribute('data-pressed');
      badge.setAttribute('data-return', '');
      badge.setAttribute('data-visible', '');
      badge.setAttribute('aria-hidden', 'false');
      badge.setAttribute('aria-label', badge.dataset.returnLabel ?? 'Back');
      badge.tabIndex = 0;
      stage.removeAttribute('data-badge-tracking');
      cursor?.removeAttribute('data-visible');
      const sr = stage.getBoundingClientRect();
      const media = focusedMediaRect(frame);
      const insetX = badge.offsetWidth / 2 + 18;
      const insetY = badge.offsetHeight / 2 + 18;
      badgeTargetX = media.left - sr.left + insetX;
      badgeTargetY = media.bottom - sr.top - insetY;
      if (reducedMotion.matches || !badgeVisible) {
        cancelAnimationFrame(badgeRaf);
        badgeRaf = 0;
        badgeX = badgeTargetX;
        badgeY = badgeTargetY;
        badge.style.translate = `${badgeX.toFixed(1)}px ${badgeY.toFixed(1)}px`;
      } else if (!badgeRaf) {
        badgeTime = performance.now();
        badgeRaf = requestAnimationFrame(stepBadge);
      }
      badgeVisible = true;
    }

    function syncBadge(snap = false) {
      if (!badge || !focused || !focused.hasAttribute('data-focus-ready')) {
        hideBadge();
        return;
      }

      if (focused.hasAttribute('data-selected')) {
        showReturnBadge(focused);
        return;
      }
      const returning = badge.hasAttribute('data-return');
      badge.removeAttribute('data-return');
      badge.setAttribute('aria-hidden', 'true');
      badge.tabIndex = -1;

      if (pointerActive && finePointer.matches) {
        const media = focusedMediaRect(focused);
        const inside =
          pointerX >= media.left &&
          pointerX <= media.right &&
          pointerY >= media.top &&
          pointerY <= media.bottom;
        if (inside) {
          const sr = stage.getBoundingClientRect();
          badgeTargetX = pointerX - sr.left;
          badgeTargetY = pointerY - sr.top;
          if (cursor) {
            cursor.style.translate = `${badgeTargetX.toFixed(1)}px ${badgeTargetY.toFixed(1)}px`;
            cursor.removeAttribute('data-docked');
            cursor.setAttribute('data-visible', '');
          }
          if (!badgeVisible || (snap && !returning) || badge.hasAttribute('data-docked') || reducedMotion.matches) {
            badgeX = badgeTargetX;
            badgeY = badgeTargetY;
            badge.style.translate = `${badgeX.toFixed(1)}px ${badgeY.toFixed(1)}px`;
          }
          badge.removeAttribute('data-docked');
          badge.setAttribute('data-visible', '');
          stage.setAttribute('data-badge-tracking', '');
          badgeVisible = true;
          if (!reducedMotion.matches && !badgeRaf) {
            badgeTime = performance.now();
            badgeRaf = requestAnimationFrame(stepBadge);
          }
          return;
        }
      }

      if (coarseHover.matches || focused.matches(':focus-visible')) {
        dockBadge(focused);
        return;
      }

      hideBadge();
    }

    function disposeVideo(video: HTMLVideoElement) {
      leaving.delete(video);
      video.pause();
      video.remove();
      video.removeAttribute('src');
      video.load();
    }

    function stopPreview(immediate = false) {
      generation++;
      if (immediate) {
        for (const video of [...leaving]) disposeVideo(video);
      }
      if (!preview) return;
      const video = preview;
      preview = undefined;
      video.closest<HTMLElement>('[data-project-frame]')?.removeAttribute('data-video-active');
      video.pause();

      const shouldFadeOut = !immediate && !document.hidden && !reducedMotion.matches && video.hasAttribute('data-visible');
      if (!shouldFadeOut) {
        disposeVideo(video);
        return;
      }

      leaving.add(video);
      video.setAttribute('data-leaving', '');
      video.removeAttribute('data-visible');
      const animations = video.getAnimations();
      if (animations.length === 0) {
        disposeVideo(video);
        return;
      }
      void Promise.race([
        Promise.allSettled(animations.map(animation => animation.finished)),
        new Promise(resolve => window.setTimeout(resolve, 350)),
      ]).then(() => {
        if (leaving.has(video)) disposeVideo(video);
      });
    }

    function attachVideo(frame: HTMLElement, src: string) {
      if (preview && preview.closest<HTMLElement>('[data-project-frame]') === frame) return preview;
      stopPreview(true);
      const video = document.createElement('video');
      preview = video;
      video.className = 'focus-video';
      video.width = 1280;
      video.height = 720;
      video.muted = video.loop = video.playsInline = true;
      video.preload = 'auto';
      video.setAttribute('aria-hidden', 'true');
      video.src = src;
      frame.querySelector('figure')!.append(video);
      return video;
    }

    function warmPreview(frame: HTMLElement) {
      const src = frame.dataset.videoSrc;
      if (!src || !stageVisible || document.hidden || reducedMotion.matches) return;
      const video = attachVideo(frame, src);
      if (video.readyState === 0) video.load();
    }

    async function syncPreview(expanding = false) {
      const frame = focused;
      const src = frame?.dataset.videoSrc;
      if (!frame || !src || !stageVisible || document.hidden || reducedMotion.matches) {
        stopPreview(document.hidden || reducedMotion.matches);
        return;
      }
      const existing = preview?.closest<HTMLElement>('[data-project-frame]') === frame ? preview : undefined;
      if (existing?.hasAttribute('data-visible')) return;
      const current = ++generation;
      const video = existing ?? attachVideo(frame, src);
      const ready = new Promise<void>((resolve) => {
        if (typeof video.requestVideoFrameCallback === 'function') video.requestVideoFrameCallback(() => resolve());
        else video.addEventListener('playing', () => resolve(), { once: true });
      });
      // Align the radial reveal with the card's overshoot apex so growth and transition flow as one motion.
      const apex = expanding
        ? new Promise<void>(resolve => window.setTimeout(resolve, 90))
        : Promise.resolve();
      try {
        await video.play();
      } catch {
        if (preview === video) stopPreview(true);
        return;
      }
      await Promise.all([ready, apex]);
      if (current !== generation || frame !== focused || preview !== video) return;
      video.setAttribute('data-visible', '');
      frame.setAttribute('data-video-active', '');
    }
    new IntersectionObserver(([entry]) => {
      stageVisible = entry.isIntersecting;
      void syncPreview();
    }).observe(stage);
    document.addEventListener('visibilitychange', () => { void syncPreview(); });
    reducedMotion.addEventListener('change', () => {
      void syncPreview();
      if (reducedMotion.matches && focused && !focused.hasAttribute('data-focus-ready')) {
        markFocusReady(focused);
      }
    });

    function notify(project: HTMLElement) {
      const { projectId = '', projectIndex = '', leftOverride } = project.dataset;
      if (!root) return;
      root.dataset.activeProject = projectId;
      root.dispatchEvent(new CustomEvent<HeroProjectChangeDetail>(HERO_EVENTS.PROJECT_CHANGE, {
        detail: { projectId, index: projectIndex, leftMediaOverride: leftOverride ? JSON.parse(leftOverride) : undefined },
      }));
    }

    let lastHudMod = -1;
    function syncStageHud(slideIndex: number) {
      const activeMod = ((slideIndex % count) + count) % count;
      if (activeMod === lastHudMod) return;
      lastHudMod = activeMod;
      const frame = card(slideIndex);
      if (hudCurrent) hudCurrent.textContent = frame.dataset.projectIndex ?? String(activeMod + 1).padStart(2, '0');
      const categories = parseCategories(frame.dataset.projectCategory ?? '');
      if (hudCategory) {
        hudCategory.hidden = categories.length === 0;
        const nodes: Array<string | HTMLElement> = [];
        for (let i = 0; i < categories.length; i++) {
          if (i > 0) {
            const sep = document.createElement('span');
            sep.className = 'stage-hud__tag-sep';
            sep.setAttribute('aria-hidden', 'true');
            sep.textContent = '·';
            nodes.push(' ', sep, ' ');
          }
          const tag = document.createElement('span');
          tag.className = 'stage-hud__tag';
          tag.textContent = categories[i];
          nodes.push(tag);
        }
        hudCategory.replaceChildren(...nodes);
      }
      for (let i = 0; i < railTicks.length; i++) {
        const tick = railTicks[i];
        if (i === activeMod) tick.setAttribute('data-active', '');
        else tick.removeAttribute('data-active');
        const isNear = count > 1 && (i === (activeMod - 1 + count) % count || i === (activeMod + 1) % count);
        if (isNear) tick.setAttribute('data-near', '');
        else tick.removeAttribute('data-near');
      }
    }

    function highlight() {
      const position = track.scrollTop;
      const left = Math.max(0, Math.min(slides.length - 2, Math.floor((position - centers[0]) / step)));
      const nearest = position - centers[left] < centers[left + 1] - position ? left : left + 1;
      if (candidate !== nearest) {
        card(candidate).removeAttribute('data-candidate');
        card(candidate).setAttribute('aria-hidden', 'true');
        card(candidate).tabIndex = -1;
        const { softTone, darkTone } = card(nearest).dataset;
        backdrop.style.setProperty('--preview-soft', softTone!);
        backdrop.style.setProperty('--preview-dark', darkTone!);
      }
      candidate = nearest;
      syncStageHud(candidate);
      renderNames();
      if (!card(candidate).hasAttribute('data-candidate')) card(candidate).setAttribute('data-candidate', '');
      card(candidate).removeAttribute('aria-hidden');
      card(candidate).tabIndex = card(candidate).hasAttribute('data-focus-ready') ? 0 : -1;
      if (reducedMotion.matches) {
        clearRelease();
        return;
      }

      // Cover every card that can intersect the viewport at the tighter list pitch.
      // Earlier prefix offsets cancel when the interpolated anchor is subtracted.
      const first = Math.max(0, left - 4);
      const last = Math.min(slides.length - 1, left + 5);
      const scaleAt = (index: number) => {
        const proximity = Math.max(0, 1 - Math.abs(centers[index] - position) / step);
        return 0.4 + (peakScale - 0.4) * proximity * proximity * (3 - 2 * proximity);
      };
      const outgoing = releaseGeometry(position, step, scaleAt, baseWidth, baseHeight);
      let accumulated = 0;
      const offsets: number[] = [];
      for (let index = first; index <= last; index++) {
        const scale = scaleAt(index);
        const visibleHeight = outgoing?.index === index ? outgoing.height * outgoing.scale : baseHeight * scale;
        const extra = visibleHeight - 0.4 * baseHeight;
        const offset = accumulated + extra / 2;
        accumulated += extra;
        offsets.push(offset);
      }
      const fraction = Math.min(1, Math.max(0, (position - centers[left]) / step));
      const anchor = offsets[left - first] + (offsets[left + 1 - first] - offsets[left - first]) * fraction;
      for (let index = first; index <= last; index++) {
        const frame = card(index);
        frame.style.setProperty('--browse-scale', String(scaleAt(index)));
        frame.style.setProperty('--browse-offset', (offsets[index - first] - anchor) + 'px');
      }
      if (outgoing) {
        const { project, index, scale, width, height } = outgoing;
        project.style.transform = `translate(-50%, calc(-50% + ${offsets[index - first] - anchor}px))`;
        project.style.setProperty('--frame-scale', String(scale));
        project.style.width = width * scale + 'px';
        project.style.height = height * scale + 'px';
      }
    }

    function rebase() {
      const equivalent = middle + candidate % count;
      if (equivalent === candidate) return;

      const previousPosition = track.scrollTop;
      track.setAttribute('data-rebasing', '');
      const position = previousPosition + center(equivalent) - center(candidate);
      const windowSize = Math.min(2, Math.floor((Math.abs(equivalent - candidate) - 1) / 2));

      // Carry the whole visible neighborhood, not just the highlighted image.
      for (let offset = -windowSize; offset <= windowSize; offset++) {
        const source = slides[candidate + offset];
        const target = slides[equivalent + offset];
        if (!source || !target) continue;

        const current = source.firstElementChild!;
        const replacement = target.firstElementChild!;
        // Keep the frame first: title labels stay attached to their original slots.
        if (typeof source.moveBefore === 'function') {
          source.moveBefore(replacement, current);
          target.moveBefore(current, target.firstElementChild);
        } else {
          source.insertBefore(replacement, current);
          target.insertBefore(current, target.firstElementChild);
        }
      }

      candidate = equivalent;
      track.scrollTop = position;
      scrollCorrection = track.scrollTop;
      if (wheel) {
        const shift = scrollCorrection - previousPosition;
        wheel.position += shift;
        wheel.intent += shift;
        wheel.target += shift;
      }
      if (release) release.origin += scrollCorrection - previousPosition;
      requestAnimationFrame(() => requestAnimationFrame(() => track.removeAttribute('data-rebasing')));
      highlight();
    }

    function park() {
      if (focused) return;
      highlight();
      if (candidate < middle - count || candidate >= middle + 2 * count) rebase();
    }

    function clearRelease() {
      if (!release) return;
      const { project } = release;
      project.style.removeProperty('--frame-scale');
      project.style.removeProperty('transform');
      project.style.removeProperty('width');
      project.style.removeProperty('height');
      project.removeAttribute('data-leaving-focus');
      release = undefined;
    }

    function markFocusReady(frame: HTMLElement) {
      if (focused !== frame || !frame.hasAttribute('data-focused')) return;
      frame.setAttribute('data-focus-ready', '');
      frame.removeAttribute('aria-hidden');
      frame.tabIndex = 0;
      syncBadge(true);
    }

    function waitForMediaLoad(frame: HTMLElement): Promise<void> {
      const img = frame.querySelector<HTMLImageElement>('.project-stage__image');
      const imgReady = !img || (img.complete && img.naturalWidth > 0)
        ? Promise.resolve()
        : new Promise<void>((resolve) => {
            const done = () => resolve();
            img.addEventListener('load', done, { once: true });
            img.addEventListener('error', done, { once: true });
          });

      const expectsVideo = Boolean(
        frame.dataset.videoSrc && !document.hidden && !reducedMotion.matches,
      );
      if (!expectsVideo) return imgReady;

      const videoReady = frame.hasAttribute('data-video-active')
        ? Promise.resolve()
        : new Promise<void>((resolve) => {
            const observer = new MutationObserver(() => {
              if (frame.hasAttribute('data-video-active') || frame !== focused) {
                observer.disconnect();
                resolve();
              }
            });
            observer.observe(frame, { attributes: true, attributeFilter: ['data-video-active'] });
            window.setTimeout(() => {
              observer.disconnect();
              resolve();
            }, 2200);
          });

      return Promise.all([imgReady, videoReady]).then(() => undefined);
    }

    function waitForFocusReady(frame: HTMLElement) {
      const token = ++focusReadyGeneration;
      clearTimeout(focusReadyTimer);

      const complete = () => {
        if (token !== focusReadyGeneration || focused !== frame || !frame.hasAttribute('data-focused')) return;
        clearTimeout(focusReadyTimer);
        markFocusReady(frame);
      };

      const focusTransitions = reducedMotion.matches
        ? []
        : frame.getAnimations().filter((animation) => {
            const prop = (animation as CSSTransition).transitionProperty;
            return !prop || prop === 'width' || prop === 'height';
          });

      const img = frame.querySelector<HTMLImageElement>('.project-stage__image');
      const mediaAlreadyReady = (!img || (img.complete && img.naturalWidth > 0))
        && (!frame.dataset.videoSrc || reducedMotion.matches || document.hidden || frame.hasAttribute('data-video-active'));

      if (focusTransitions.length === 0 && mediaAlreadyReady) {
        complete();
        return;
      }

      const transitionWait = focusTransitions.length
        ? Promise.allSettled(focusTransitions.map((animation) => animation.finished))
        : Promise.resolve();
      const mediaWait = waitForMediaLoad(frame);

      focusReadyTimer = window.setTimeout(complete, 2600);
      void Promise.all([transitionWait, mediaWait]).then(complete);
    }

    function releaseFocus(project: HTMLElement) {
      details?.dismiss();
      focusReadyGeneration++;
      clearTimeout(focusReadyTimer);
      hideBadge();
      stopPreview();
      if (!reducedMotion.matches) {
        const current = getComputedStyle(project);
        release = {
          project,
          origin: center(candidate),
          scale: new DOMMatrix(current.transform).a,
          width: parseFloat(current.width),
          height: parseFloat(current.height),
        };
        project.setAttribute('data-leaving-focus', '');
      }
      project.removeAttribute('data-focus-ready');
      project.removeAttribute('data-focused');
      project.tabIndex = -1;
    }

    function releaseGeometry(position: number, step: number, scaleAt: (index: number) => number, width: number, height: number) {
      if (!release) return;
      const { project, origin, scale, width: initialWidth, height: initialHeight } = release;
      const index = slides.indexOf(project.parentElement as HTMLElement);
      const progress = Math.min(1, Math.abs(position - origin) / step);
      if (progress >= 1 || index < 0) {
        clearRelease();
        return;
      }

      // Use the outgoing card's rendered height to reserve space for its neighbors.
      const blend = 1 - (1 - progress) ** 2;
      return {
        project,
        index,
        scale: scale + (scaleAt(index) - scale) * blend,
        width: initialWidth + (width - initialWidth) * blend,
        height: initialHeight + (height - initialHeight) * blend,
      };
    }
    function settle() {
      if (focused || touching || wheel) return;
      clearTimeout(parkTimer);
      park();
      const target = center(candidate);
      if (Math.abs(track.scrollTop - target) >= 2 && !aligning) {
        aligning = true;
        track.scrollTo({ top: target, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
        parkTimer = window.setTimeout(settle, 400);
        return;
      }
      aligning = false;
      track.removeAttribute('data-free-wheel');
      clearTimeout(idle);
      warmPreview(card(candidate));
      idle = window.setTimeout(focusCandidate, Math.max(0, 1000 - (performance.now() - lastUserScroll)));
    }
    function focusCandidate() {
      clearRelease();
      focused = card(candidate);
      focused.removeAttribute('data-focus-ready');
      focused.tabIndex = -1;
      focused.setAttribute('data-focused', '');
      focused.removeAttribute('data-candidate');
      void syncPreview(!reducedMotion.matches);
      if (root?.dataset.activeProject !== focused.dataset.projectId) notify(focused);
      waitForFocusReady(focused);
    }

    track.scrollTop = center(candidate);
    syncStageHud(candidate);
    renderNames();
    if (focused) {
      const initialImg = focused.querySelector<HTMLImageElement>('.project-stage__image');
      const initialLoaded = (!initialImg || (initialImg.complete && initialImg.naturalWidth > 0))
        && (!focused.dataset.videoSrc || reducedMotion.matches || document.hidden || focused.hasAttribute('data-video-active'));
      if (!initialLoaded) {
        focused.removeAttribute('data-focus-ready');
        waitForFocusReady(focused);
      } else {
        syncBadge(true);
      }
      notify(focused);
    }
    new ResizeObserver(() => {
      measure();
      if (focused) {
        track.scrollTop = center(candidate);
        syncBadge(true);
      } else {
        highlight();
      }
      renderNames();
    }).observe(track);
    void document.fonts.ready.then(() => {
      measure();
      renderNames();
    });

    function cancelPendingFocus() {
      clearTimeout(idle);
      if (!focused && preview) stopPreview(true);
      if (!aligning) return;
      aligning = false;
      clearTimeout(parkTimer);
      track.scrollTo({ top: track.scrollTop, behavior: 'instant' });
    }

    function stopWheel() {
      cancelAnimationFrame(wheelFrame);
      wheel = undefined;
      track.removeAttribute('data-free-wheel');
    }

    function advanceWheel(now: number) {
      if (!wheel) return;
      // Exact critically damped step: retarget without resetting position or velocity.
      const dt = Math.max(0, Math.min(48, now - wheel.time));
      wheel.time = now;
      const rate = 1 / 76;
      // Blend into the landing from the first frame, not after an inactivity timeout.
      const age = Math.max(0, now - lastUserScroll);
      const attraction = 1 - Math.exp(-((age / 100) ** 2));
      const aim = wheel.intent + (wheel.target - wheel.intent) * attraction;
      const offset = wheel.position - aim;
      const carry = wheel.velocity + rate * offset;
      const decay = Math.exp(-rate * dt);
      wheel.position = aim + (offset + carry * dt) * decay;
      wheel.velocity = (wheel.velocity - rate * carry * dt) * decay;
      const arrived = Math.abs(aim - wheel.target) < 0.5 && Math.abs(wheel.position - wheel.target) < 0.5 && Math.abs(wheel.velocity) < 0.02;
      track.scrollTop = arrived ? wheel.target : wheel.position;
      renderScrollPosition();
      if (!arrived) {
        wheelFrame = requestAnimationFrame(advanceWheel);
        return;
      }
      scrollCorrection = track.scrollTop;
      stopWheel();
      settle();
    }

    const EXIT_SCROLL_THRESHOLD = 280;
    const EXIT_STEP_CAP = 120;
    const EXIT_DECAY_DELAY = 380;
    const EXIT_DECAY_RATE = 2.4;
    let exitProgress = 0;
    let exitDecayRaf = 0;
    let exitLastInput = 0;
    let exitLastTime = 0;
    let touchLastY = 0;

    const isDetailsOpen = () => Boolean(details?.isOpen() || root?.hasAttribute('data-details-open'));

    function renderExitButton() {
      if (!exitButton) return;
      const clamped = Math.max(0, Math.min(1, exitProgress));
      exitButton.style.setProperty('--exit-progress', clamped.toFixed(3));
      if (clamped > 0 && isDetailsOpen()) {
        exitButton.setAttribute('data-visible', '');
        exitButton.setAttribute('aria-hidden', 'false');
        exitButton.tabIndex = 0;
      } else {
        exitButton.removeAttribute('data-visible');
        exitButton.setAttribute('aria-hidden', 'true');
        exitButton.tabIndex = -1;
      }
    }

    function resetExitProgress() {
      cancelAnimationFrame(exitDecayRaf);
      exitDecayRaf = 0;
      exitProgress = 0;
      renderExitButton();
    }

    function stepExitDecay(now: number) {
      exitDecayRaf = 0;
      if (!isDetailsOpen() || exitProgress <= 0) {
        resetExitProgress();
        return;
      }
      const dt = Math.max(0, Math.min(48, now - exitLastTime)) / 1000;
      exitLastTime = now;
      if (now - exitLastInput > EXIT_DECAY_DELAY) {
        exitProgress = Math.max(0, exitProgress - EXIT_DECAY_RATE * dt);
        renderExitButton();
      }
      if (exitProgress > 0) {
        exitDecayRaf = requestAnimationFrame(stepExitDecay);
      }
    }

    function completeExitAndScroll() {
      resetExitProgress();
      const current = focused;
      if (!current) {
        details?.dismiss();
        return;
      }
      releaseFocus(current);
      focused = undefined;
      const nextIndex = Math.min(slides.length - 1, candidate + 1);
      const target = center(nextIndex);
      if (reducedMotion.matches) {
        track.scrollTop = target;
        renderScrollPosition();
        settle();
        return;
      }
      const position = track.scrollTop;
      track.setAttribute('data-free-wheel', '');
      wheel = {
        position,
        intent: target,
        target,
        velocity: 0,
        time: performance.now(),
        direction: 1,
      };
      lastUserScroll = performance.now();
      wheelFrame = requestAnimationFrame(advanceWheel);
    }

    function pushExitScroll(rawDelta: number) {
      if (!isDetailsOpen()) return;
      const now = performance.now();
      exitLastInput = now;
      if (rawDelta > 0) {
        const step = Math.min(rawDelta, EXIT_STEP_CAP);
        exitProgress = Math.min(1, exitProgress + step / EXIT_SCROLL_THRESHOLD);
      } else if (rawDelta < 0 && exitProgress > 0) {
        const step = Math.min(Math.abs(rawDelta), EXIT_STEP_CAP);
        exitProgress = Math.max(0, exitProgress - step / EXIT_SCROLL_THRESHOLD);
      }
      renderExitButton();
      if (exitProgress >= 1) {
        completeExitAndScroll();
        return;
      }
      if (exitProgress > 0 && !exitDecayRaf) {
        exitLastTime = now;
        exitDecayRaf = requestAnimationFrame(stepExitDecay);
      }
    }

    if (root) {
      new MutationObserver(() => {
        const open = isDetailsOpen();
        if (hud) hud.inert = open;
        if (!open && exitProgress > 0) resetExitProgress();
        syncBadge();
      }).observe(root, { attributes: true, attributeFilter: ['data-details-open'] });
    }

    badge?.addEventListener('click', () => {
      if (isDetailsOpen()) details?.dismiss(true);
    });

    exitButton?.addEventListener('click', () => {
      if (isDetailsOpen()) completeExitAndScroll();
    });

    exitButton?.addEventListener('wheel', (event) => {
      if (!isDetailsOpen() || event.ctrlKey || !event.deltaY || Math.abs(event.deltaX) > Math.abs(event.deltaY) || !event.cancelable) return;
      event.preventDefault();
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? track.clientHeight : 1;
      pushExitScroll(event.deltaY * unit);
    }, { passive: false });

    function stepBy(direction: -1 | 1) {
      if (isDetailsOpen()) return;
      cancelPendingFocus();
      clearTimeout(parkTimer);
      if (focused) {
        releaseFocus(focused);
        focused = undefined;
      }
      const baseIndex = wheel
        ? Math.round((wheel.target - center(0)) / step)
        : candidate;
      const nextIndex = Math.max(0, Math.min(slides.length - 1, baseIndex + direction));
      if (nextIndex === baseIndex && wheel) return;
      if (nextIndex === candidate && !wheel && Math.abs(track.scrollTop - center(nextIndex)) < 2) {
        return;
      }
      const target = center(nextIndex);
      if (reducedMotion.matches) {
        stopWheel();
        track.scrollTop = target;
        renderScrollPosition();
        settle();
        return;
      }
      const now = performance.now();
      lastUserScroll = now;
      if (!wheel) {
        track.setAttribute('data-free-wheel', '');
        wheel = {
          position: track.scrollTop,
          intent: target,
          target,
          velocity: 0,
          time: now,
          direction,
        };
        wheelFrame = requestAnimationFrame(advanceWheel);
      } else {
        wheel.direction = direction;
        wheel.intent = target;
        wheel.target = target;
      }
    }

    prevBtn?.addEventListener('click', () => stepBy(-1));
    nextBtn?.addEventListener('click', () => stepBy(1));

    track.addEventListener('wheel', (event) => {
      if (event.ctrlKey || !event.deltaY || Math.abs(event.deltaX) > Math.abs(event.deltaY)
        || !event.cancelable) return;
      if (isDetailsOpen()) {
        event.preventDefault();
        const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? track.clientHeight : 1;
        pushExitScroll(event.deltaY * unit);
        return;
      }
      if (reducedMotion.matches) return;
      event.preventDefault();
      cancelPendingFocus();
      clearTimeout(parkTimer);
      const now = performance.now();
      const step = center(1) - center(0);
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? track.clientHeight : 1;
      const delta = Math.sign(event.deltaY) * Math.min(Math.abs(event.deltaY * unit), step * count);
      const direction = Math.sign(delta);
      if (!wheel) {
        track.setAttribute('data-free-wheel', '');
        const position = track.scrollTop;
        wheel = { position, intent: position, target: position, velocity: 0, time: now, direction };
        wheelFrame = requestAnimationFrame(advanceWheel);
      }
      if (direction !== wheel.direction) wheel.intent = wheel.target = wheel.position;
      wheel.direction = direction;
      // Accumulate input independently of the displayed position, including tiny trackpad deltas.
      wheel.intent += delta;
