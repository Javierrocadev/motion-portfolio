---
import {
  getAlternateLocale,
  getLocalizedPath,
  ROUTE_ORDER,
  type Locale,
  type RouteKey,
} from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';
import BrandMark from './BrandMark.astro';

interface Props {
  locale: Locale;
  currentRoute: RouteKey;
}

const { locale, currentRoute } = Astro.props;
const t = getTranslations(locale);
const alternateLocale = getAlternateLocale(locale);
const alternateHref = getLocalizedPath(currentRoute, alternateLocale);
const homeHref = getLocalizedPath('home', locale);
---

<header class="site-nav-header is-wide" data-site-nav>
  <div class="site-nav__inner" data-site-nav-inner>
    <div class="site-nav__left" data-site-nav-left>
      <div class="site-nav__orb-layer" data-orb-layer aria-hidden="true">
        <span class="site-nav__orb site-nav__orb--1" data-orb="0"></span>
        <span class="site-nav__orb site-nav__orb--2" data-orb="1"></span>
        <span class="site-nav__orb site-nav__orb--3" data-orb="2"></span>
        <span class="site-nav__orb site-nav__orb--4" data-orb="3"></span>
      </div>

      <nav class="site-nav" aria-label={t.nav.ariaLabel}>
        <button
          type="button"
          class="site-nav__btn site-nav__toggle"
          data-site-nav-toggle
          data-orb-item
          popovertarget="site-nav-menu"
          aria-controls="site-nav-menu"
          aria-expanded="false"
        >
          <span class="site-nav__btn-label">
            <svg
              class="site-nav__toggle-icon"
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
            <span>{t.nav.menuButton}</span>
          </span>
        </button>

        <ul
          id="site-nav-menu"
          class="site-nav__list"
          data-site-nav-list
        >
          {
            ROUTE_ORDER.map((routeKey) => {
              const href = getLocalizedPath(routeKey, locale);
              const isCurrent = routeKey === currentRoute;
              return (
                <li class="site-nav__item">
                  <a
                    href={href}
                    class="site-nav__btn site-nav__link"
                    data-orb-item
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    <span class="site-nav__btn-label">
                      <span class="site-nav__btn-text">{t.nav.items[routeKey]}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <a
        href={alternateHref}
        hreflang={alternateLocale}
        lang={alternateLocale}
        class="site-nav__btn site-nav__lang-btn"
        data-orb-item
        aria-label={t.nav.switchToLanguage}
      >
        <span class="site-nav__btn-label">
          <span class="site-nav__btn-text">{alternateLocale.toUpperCase()}</span>
        </span>
      </a>
    </div>

    <a
      href={homeHref}
      class="site-nav__brand"
      aria-label={t.nav.brandHomeAria}
    >
      <BrandMark />
    </a>
  </div>
</header>

<script is:inline>
  (() => {
    const ORB_SIZES = [28, 21, 14, 8];
    const ORB_STATE_KEY = 'motion-portfolio:nav-orb-state';
    const header = document.currentScript && document.currentScript.previousElementSibling;
    if (!(header instanceof HTMLElement) || !header.matches('[data-site-nav]')) return;

    const inner = header.querySelector('[data-site-nav-inner]');
    const leftBox = header.querySelector('[data-site-nav-left]');
    const orbLayer = header.querySelector('[data-orb-layer]');
    const toggle = header.querySelector('[data-site-nav-toggle]');
    const list = header.querySelector('[data-site-nav-list]');
    const orbs = Array.from(header.querySelectorAll('[data-orb]'));
    if (!inner || !leftBox || !orbLayer || !toggle || !list || orbs.length !== ORB_SIZES.length) {
      return;
    }

    header.classList.add('is-measuring', 'is-wide');
    const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;
    if (!fitsInline) {
      header.classList.remove('is-wide');
      list.setAttribute('popover', 'auto');
    }

    let saved = null;
    try {
      const raw = sessionStorage.getItem(ORB_STATE_KEY);
      if (raw) {
        saved = JSON.parse(raw);
        sessionStorage.removeItem(ORB_STATE_KEY);
      }
    } catch {}

    const normalize = (path) => {
      const clean = String(path || '/').split(/[?#]/)[0] || '/';
      return clean.length > 1 ? clean.replace(/\/+$/, '') : '/';
    };
    const currentPath = normalize(location.pathname);

    let target = null;
    let hovered = false;
    let preinitKind = 'rest';

    if (fitsInline) {
      const currentLink = header.querySelector('.site-nav__link[aria-current="page"]');
      const langBtn = header.querySelector('.site-nav__lang-btn');
      if (saved && saved.hovered) {
        if (saved.kind === 'lang' && langBtn) {
          target = langBtn;
          hovered = true;
          preinitKind = 'lang';
        } else if (saved.href && normalize(saved.href) === currentPath && currentLink) {
          target = currentLink;
          hovered = true;
          preinitKind = 'route';
        }
      }
      if (!target) {
        target = currentLink || header.querySelector('.site-nav__link[data-orb-item]');
      }
    } else {
      target = toggle;
    }

    if (target) {
      const boxRect = leftBox.getBoundingClientRect();
      const tRect = target.getBoundingClientRect();
      if (boxRect.width > 0 && tRect.width > 0 && tRect.height > 0) {
        const left = tRect.left - boxRect.left;
        const top = tRect.top - boxRect.top;
        const width = tRect.width;
        const height = tRect.height;
        const centerX = left + width / 2;
        const centerY = top + height / 2;

        const coords = hovered
          ? ORB_SIZES.map((d) => [centerX - d / 2, centerY - d / 2, 1.5])
          : [
              [left + width * 0.52, top + height * 0.52, 1],
              [left + width * 0.22, top - ORB_SIZES[1] * 0.25, 1],
              [left + width * 0.04, top + height * 0.34, 1],
              [left + width - ORB_SIZES[3] - 2, top + height * 0.64, 1],
            ];

        for (let i = 0; i < orbs.length; i += 1) {
          const [x, y, scale] = coords[i];
          orbs[i].style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale})`;
        }

        orbLayer.dataset.hovered = hovered ? 'true' : 'false';
        orbLayer.dataset.orbsReady = 'true';
      }
    }

    header.dataset.navPreinit = preinitKind;
  })();
</script>

<script>
  const ORB_SIZES = [28, 21, 14, 8] as const;
  const ORB_STATE_KEY = 'motion-portfolio:nav-orb-state';

  for (const header of document.querySelectorAll<HTMLElement>('[data-site-nav]')) {
    const inner = header.querySelector<HTMLElement>('[data-site-nav-inner]');
    const leftBox = header.querySelector<HTMLElement>('[data-site-nav-left]');
    const orbLayer = header.querySelector<HTMLElement>('[data-orb-layer]');
    const toggle = header.querySelector<HTMLButtonElement>('[data-site-nav-toggle]');
    const list = header.querySelector<HTMLElement>('[data-site-nav-list]');
    const orbs = Array.from(header.querySelectorAll<HTMLElement>('[data-orb]'));
    if (!inner || !leftBox || !orbLayer || !toggle || !list || orbs.length !== ORB_SIZES.length) {
      continue;
    }

    const supportsPopover = Object.hasOwn(HTMLElement.prototype, 'popover');
    let lastWidth = 0;
    let activeHoverTarget: HTMLElement | null = null;
    let pointerInside = false;

    const isOpen = () => {
      if (supportsPopover && list.hasAttribute('popover')) {
        try {
          return list.matches(':popover-open');
        } catch {
          return false;
        }
      }
      return list.classList.contains(':popover-open');
    };

    const syncExpanded = () => {
      toggle.setAttribute('aria-expanded', String(isOpen()));
    };

    if (supportsPopover) {
      list.addEventListener('toggle', syncExpanded);
    } else {
      // Lightweight fallback for browsers without native Popover API.
      toggle.addEventListener('click', () => {
        if (header.classList.contains('is-wide')) return;
        list.classList.toggle(':popover-open');
        syncExpanded();
      });
    }

    const isTrackableItem = (el: HTMLElement | null): el is HTMLElement => {
      if (!el || !el.matches('[data-orb-item]')) return false;
      const isWide = header.classList.contains('is-wide');
      if (!isWide && el.classList.contains('site-nav__link')) return false;
      if (isWide && el === toggle) return false;
      return el.offsetWidth > 0 && el.offsetHeight > 0;
    };

    const getRestTarget = (): HTMLElement | null => {
      if (header.classList.contains('is-wide')) {
        const current = header.querySelector<HTMLElement>('.site-nav__link[aria-current="page"]');
        if (isTrackableItem(current)) return current;
        const firstLink = header.querySelector<HTMLElement>('.site-nav__link[data-orb-item]');
        if (isTrackableItem(firstLink)) return firstLink;
      }
      return isTrackableItem(toggle) ? toggle : null;
    };

    const positionOrbs = (target: HTMLElement | null, hovered: boolean) => {
      if (!target) {
        orbLayer.dataset.orbsReady = 'false';
        return;
      }

      const boxRect = leftBox.getBoundingClientRect();
      const tRect = target.getBoundingClientRect();
      if (boxRect.width === 0 || tRect.width === 0 || tRect.height === 0) return;

      const left = tRect.left - boxRect.left;
      const top = tRect.top - boxRect.top;
      const width = tRect.width;
      const height = tRect.height;

      orbLayer.dataset.hovered = hovered ? 'true' : 'false';

      const centerX = left + width / 2;
      const centerY = top + height / 2;

      const coords: Array<[number, number, number]> = hovered
        ? ORB_SIZES.map((d) => [centerX - d / 2, centerY - d / 2, 1.5])
        : [
            [left + width * 0.52, top + height * 0.52, 1],
            [left + width * 0.22, top - ORB_SIZES[1] * 0.25, 1],
            [left + width * 0.04, top + height * 0.34, 1],
            [left + width - ORB_SIZES[3] - 2, top + height * 0.64, 1],
          ];

      for (let i = 0; i < orbs.length; i += 1) {
        const [x, y, scale] = coords[i];
        orbs[i].style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${scale})`;
      }
    };

    const syncCurrentOrbState = () => {
      if (isTrackableItem(activeHoverTarget)) {
        positionOrbs(activeHoverTarget, true);
      } else {
        activeHoverTarget = null;
        positionOrbs(getRestTarget(), false);
      }
    };

    leftBox.addEventListener('pointerenter', () => {
      pointerInside = true;
    });

    leftBox.addEventListener('pointerover', (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>('[data-orb-item]') ?? null;
      if (!isTrackableItem(target)) return;
      pointerInside = true;
      activeHoverTarget = target;
      positionOrbs(target, true);
    });

    leftBox.addEventListener('pointerleave', () => {
      pointerInside = false;
      const focused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      if (focused && leftBox.contains(focused) && isTrackableItem(focused) && focused.matches(':focus-visible')) {
        activeHoverTarget = focused;
        positionOrbs(focused, true);
      } else {
        activeHoverTarget = null;
        positionOrbs(getRestTarget(), false);
      }
    });

    leftBox.addEventListener('focusin', (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>('[data-orb-item]') ?? null;
      if (!isTrackableItem(target)) return;
      activeHoverTarget = target;
      positionOrbs(target, true);
    });

    leftBox.addEventListener('focusout', (event) => {
      const next = event.relatedTarget instanceof HTMLElement ? event.relatedTarget : null;
      if (next && leftBox.contains(next) && isTrackableItem(next)) return;
      if (pointerInside && isTrackableItem(activeHoverTarget)) return;
      activeHoverTarget = null;
      positionOrbs(getRestTarget(), false);
    });

    leftBox.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-orb-item]');
      if (!link) return;
      try {
        sessionStorage.setItem(
          ORB_STATE_KEY,
          JSON.stringify({
            kind: link.classList.contains('site-nav__lang-btn') ? 'lang' : 'route',
            href: link.getAttribute('href') ?? '',
            hovered: event.detail > 0 && orbLayer.dataset.hovered === 'true',
          }),
        );
      } catch {}
    });

    let rafId = 0;
    function syncLayout(force = false) {
      const container = header.parentElement;
      const availableWidth = container ? container.clientWidth : header.clientWidth;
      const currentlyWide = header.classList.contains('is-wide');

      if (!force && availableWidth === lastWidth) {
        syncCurrentOrbState();
        return;
      }

      // While collapsed, only remeasure when the container grows to prevent resize thrash.
      if (!force && !currentlyWide && availableWidth < lastWidth) {
        lastWidth = availableWidth;
        syncCurrentOrbState();
        return;
      }
      lastWidth = availableWidth;

      const wasOpen = !currentlyWide && isOpen();
      header.classList.add('is-measuring', 'is-wide');
      list.removeAttribute('popover');
      list.classList.remove(':popover-open');

      const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;

      if (fitsInline) {
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        header.classList.remove('is-wide');
        list.setAttribute('popover', 'auto');
        if (wasOpen) {
          if (supportsPopover) {
            try {
              list.showPopover();
            } catch {}
          } else {
            list.classList.add(':popover-open');
          }
        }
        syncExpanded();
      }

      syncCurrentOrbState();

      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
        orbLayer.dataset.orbsReady = 'true';
      });
    }

    const preinit = header.dataset.navPreinit;
    if (preinit) {
      const container = header.parentElement;
      lastWidth = container ? container.clientWidth : header.clientWidth;

      if (preinit === 'lang') {
        const langBtn = header.querySelector<HTMLElement>('.site-nav__lang-btn');
        if (isTrackableItem(langBtn)) activeHoverTarget = langBtn;
      } else if (preinit === 'route') {
        const current = header.querySelector<HTMLElement>('.site-nav__link[aria-current="page"]');
        if (isTrackableItem(current)) activeHoverTarget = current;
      }

      rafId = requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
        if (orbLayer.dataset.orbsReady !== 'true') {
          syncCurrentOrbState();
          orbLayer.dataset.orbsReady = 'true';
        }
      });

      if (activeHoverTarget) {
        const settlePreinitHover = () => {
          if (pointerInside || leftBox.matches(':hover') || leftBox.matches(':focus-within')) return;
          activeHoverTarget = null;
          positionOrbs(getRestTarget(), false);
        };
        window.addEventListener('pointermove', settlePreinitHover, { once: true, passive: true });
      }
    } else {
      syncLayout(true);
    }

    if ('fonts' in document && document.fonts.status !== 'loaded') {
      document.fonts.ready.then(() => syncLayout(true));
    }

    const observer = new ResizeObserver(() => syncLayout(false));
    if (header.parentElement) observer.observe(header.parentElement);
    observer.observe(header);
    observer.observe(leftBox);
  }
</script>

<style>
  .site-nav-header {
    --nav-pad-block: var(--panel-pad-block, clamp(0.75rem, 1.3dvw, 1.15rem));
    --nav-pad-inline: var(--panel-pad-inline, clamp(0.9rem, 1.8dvw, 1.5rem));
    --nav-btn-radius: 0.45rem;
    --orb-1: #18181b;
    --orb-2: #3f3f46;
    --orb-3: #71717a;
    --orb-4: #e4e4e7;

    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    inline-size: 100%;
    padding-block: var(--nav-pad-block);
    padding-inline: var(--nav-pad-inline);
    z-index: 25;
    pointer-events: none;
    view-transition-name: site-nav;
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    inline-size: 100%;
    pointer-events: none;
  }

  .site-nav__inner > * {
    flex-shrink: 0;
  }

  .site-nav-header.is-measuring,
  .site-nav-header.is-measuring * {
    transition: none !important;
  }

  /* Left cluster: shared orb layer + transparent borderless nav buttons + locale switch */
  .site-nav__left {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    white-space: nowrap;
    pointer-events: auto;
  }

  /* Shared 4-orb layer (no rectangular background) that glides freely across nav buttons */
  .site-nav__orb-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
    background-color: transparent;
    opacity: 0;
    transition: opacity 240ms var(--ease-editorial);
  }

  .site-nav__orb-layer[data-orbs-ready='true'] {
    opacity: 0.64;
  }

  .site-nav__orb-layer[data-orbs-ready='true'][data-hovered='true'] {
    opacity: 0.88;
  }

  .site-nav__orb {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    border-radius: 999px;
    will-change: transform;
  }

  .site-nav__orb--1 {
    inline-size: 28px;
    block-size: 28px;
    background-color: var(--orb-1);
  }

  .site-nav__orb--2 {
    inline-size: 21px;
    block-size: 21px;
    background-color: var(--orb-2);
  }

  .site-nav__orb--3 {
    inline-size: 14px;
    block-size: 14px;
    background-color: var(--orb-3);
  }

  .site-nav__orb--4 {
    inline-size: 8px;
    block-size: 8px;
    background-color: var(--orb-4);
  }

  .site-nav {
    display: flex;
    align-items: center;
  }

  /* Borderless, background-free nav buttons */
  .site-nav__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 2.15rem;
    padding-block: 0.42rem;
    padding-inline: 0.55rem;
    border: 0;
    border-radius: var(--nav-btn-radius);
    background-color: transparent;
    color: rgba(var(--fg-rgb), 0.78);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
    transition: color 300ms var(--ease-editorial);
  }

  .site-nav__btn:hover,
  .site-nav__btn:focus-visible,
  .site-nav__btn[aria-current='page'] {
    color: var(--fg);
  }

  .site-nav__btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  /* Label always paints above the shared moving orbs */
  .site-nav__btn-label {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .site-nav__btn-text {
    position: relative;
  }

  /* Non-color current page indicator (out of flow so link widths never shift across pages) */
  .site-nav__link[aria-current='page'] .site-nav__btn-text::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.32rem;
    block-size: 1.5px;
    border-radius: 999px;
    background-color: var(--orb-4);
  }

  .site-nav__toggle {
    anchor-name: --site-nav-trigger;
  }

  .site-nav__lang-btn {
    padding-inline: 0.5rem;
    letter-spacing: 0.08em;
  }

  /* Collapsed popover menu */
  .site-nav__list {
    list-style: none;
    position: fixed;
    inset: auto;
    /* Fallback placement before CSS Anchor Positioning */
    inset-block-start: calc(var(--nav-pad-block) + 2.65rem);
    inset-block-start: anchor(--site-nav-trigger bottom);
    inset-inline-start: var(--nav-pad-inline);
    inset-inline-start: anchor(--site-nav-trigger left);
    inline-size: min(76dvw, 14.5rem);
    max-inline-size: calc(100dvw - 2rem);
    block-size: fit-content;
    max-block-size: calc(100dvh - 6rem);
    margin-block-start: 0.45rem;
    padding: 0.45rem;
    border: 0;
    border-radius: 0.65rem;
    background-color: color-mix(in srgb, var(--surface) 94%, transparent);
    color: var(--fg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    overflow: auto;
    pointer-events: auto;
    opacity: 0;
    transition:
      opacity 180ms var(--ease-editorial),
      display 180ms,
      overlay 180ms;
    transition-behavior: allow-discrete;
  }

  .site-nav__list:not(:is(:popover-open, .\:popover-open)) {
    display: none;
  }

  .site-nav__list:is(:popover-open, .\:popover-open) {
    display: grid;
    gap: 0.25rem;
    opacity: 1;
    translate: 0 0;
  }

  .site-nav__list:is(:popover-open, .\:popover-open) .site-nav__link {
    inline-size: 100%;
    background-color: transparent;
  }

  /* Inline desktop layout */
  .site-nav-header.is-wide .site-nav__toggle {
    display: none;
  }

  .site-nav-header.is-wide .site-nav__list {
    position: static;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    inline-size: auto;
    max-inline-size: none;
    block-size: auto;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: visible;
    opacity: 1;
    translate: none;
    transition: none;
  }

  .site-nav-header.is-wide .site-nav__list::backdrop {
    display: none;
  }

  /* Standalone animated JR logo on the right, borderless */
  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.35rem;
    padding-inline: 0.2rem;
    border: 0;
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--nav-btn-radius);
    pointer-events: auto;
  }

  .site-nav__brand:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  /* Opt in to spatial motion only when the user allows motion */
  @media (prefers-reduced-motion: no-preference) {
    .site-nav__orb--1 {
      transition: transform 620ms var(--ease-editorial);
    }

    .site-nav__orb--2 {
      transition: transform 700ms var(--ease-editorial);
    }

    .site-nav__orb--3 {
      transition: transform 760ms var(--ease-editorial);
    }

    .site-nav__orb--4 {
      transition: transform 820ms var(--ease-editorial);
    }

    .site-nav__list {
      translate: 0 -6px;
      transition:
        opacity 180ms var(--ease-editorial),
        translate 180ms var(--ease-editorial),
        display 180ms,
        overlay 180ms;
      transition-behavior: allow-discrete;
    }
  }

