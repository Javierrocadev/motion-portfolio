---
const LOGO_PATH =
  'M13.0908 1.65039V14.1162C13.0755 14.1274 13.0583 14.1404 13.0391 14.1543C12.9546 14.2153 12.8337 14.3015 12.6895 14.3984C12.4144 14.5833 12.0569 14.8056 11.7041 14.9834C11.2188 15.2212 10.7066 15.4131 10.1719 15.5498C9.53748 15.7119 8.87215 15.7988 8.18652 15.7998H8.16309L7.76562 15.79C3.68605 15.5856 0.415296 12.3421 0.200195 8.29688C0.193912 8.17864 0.291315 8.07247 0.424805 8.07227H6.0459L7.72656 9.74023C7.97466 9.98658 8.37492 9.98654 8.62305 9.74023L10.2334 8.1416C10.3534 8.02249 10.4217 7.86045 10.4219 7.69141V0.322266L13.0908 1.65039ZM19.9033 0.200195L20.2979 0.209961C24.3419 0.414339 27.5864 3.65653 27.7998 7.70312C27.806 7.82143 27.7086 7.92749 27.5752 7.92773H22.0049L20.3428 6.26367C20.0942 6.01484 19.69 6.01484 19.4414 6.26367L17.8486 7.85938C17.7298 7.97836 17.6622 8.13946 17.6621 8.30762V15.6758L15.0176 14.3496V1.88281C15.0328 1.87154 15.0501 1.85874 15.0693 1.84473C15.1531 1.78372 15.273 1.69847 15.416 1.60156C15.6946 1.41277 16.0579 1.18339 16.415 1.00391C16.8895 0.771366 17.3903 0.584672 17.9121 0.450195C18.4623 0.308424 19.0359 0.223598 19.626 0.204102L19.8809 0.200195H19.9033Z';
---

<span class="brand-mark" data-brand-mark aria-hidden="true">
  <svg
    class="brand-mark__svg"
    width="38"
    height="22"
    viewBox="-0.8 -0.8 29.6 17.6"
    fill="none"
    focusable="false"
  >
    <path class="brand-mark__base" d={LOGO_PATH} />
    <path class="brand-mark__stroke brand-mark__stroke--normal" d={LOGO_PATH} pathLength="360" />
    <path class="brand-mark__stroke brand-mark__stroke--reverse" d={LOGO_PATH} pathLength="360" />
  </svg>
</span>

<script>
  for (const mark of document.querySelectorAll<HTMLElement>('[data-brand-mark]')) {
    let inView = true;

    const syncPaused = () => {
      mark.dataset.paused = String(!inView || document.hidden);
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        syncPaused();
      },
      { threshold: 0 },
    );

    observer.observe(mark);
    document.addEventListener('visibilitychange', syncPaused);
    syncPaused();
  }
</script>

<style>
  .brand-mark {
    display: inline-grid;
    place-items: center;
    inline-size: 2.45rem;
    block-size: 1.45rem;
    flex-shrink: 0;
    /* Isolate repaints strictly to this tiny tile so the nav backdrop-filter is never invalidated. */
    contain: strict;
    isolation: isolate;
    transform: translateZ(0);
    will-change: transform;
  }

  .brand-mark__svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .brand-mark__base {
    fill: rgba(244, 244, 245, 0.16);
    stroke: rgba(244, 244, 245, 0.2);
    stroke-width: 0.75;
    stroke-linejoin: round;
    transition: fill 220ms ease, stroke 220ms ease;
  }

  .brand-mark__stroke {
    fill: none;
    stroke-width: 0.95;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 140 220;
  }

  .brand-mark__stroke--normal {
    stroke: rgba(244, 244, 245, 0.94);
    animation: jrDashOffset 7s linear var(--brand-mark-phase, 0ms) infinite;
  }

  .brand-mark__stroke--reverse {
    stroke: rgba(244, 244, 245, 0.42);
    animation: jrDashOffsetReverse 7s linear var(--brand-mark-phase, 0ms) infinite;
  }

  .brand-mark[data-paused='true'] .brand-mark__stroke {
    animation-play-state: paused;
  }

  :global(.site-nav__brand:hover) .brand-mark__base,
  :global(.site-nav__brand:focus-visible) .brand-mark__base {
    fill: rgba(244, 244, 245, 0.28);
    stroke: rgba(244, 244, 245, 0.32);
  }

  @keyframes jrDashOffset {
    from {
      stroke-dashoffset: -5;
    }
    to {
      stroke-dashoffset: -365;
    }
  }

  @keyframes jrDashOffsetReverse {
    from {
      stroke-dashoffset: 365;
    }
    to {
      stroke-dashoffset: 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark__base {
      fill: var(--fg);
      stroke: none;
      transition: none;
    }

    .brand-mark__stroke {
      animation: none;
      stroke: none;
    }
  }

  @media (forced-colors: active) {
    .brand-mark__base {
      fill: CanvasText;
      stroke: none;
    }

    .brand-mark__stroke {
      stroke: Highlight;
    }
  }
</style>
